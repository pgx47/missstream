---
import BaseLayout from '../../layouts/BaseLayout.astro';
import streamers from '../../data/streamers.json';
---

<BaseLayout
  title="Setups des streamers"
  description="Le matériel exact des streamers francophones — Gotaga, Squeezie, Kameto — et les alternatives abordables pour chaque pièce."
>
  <div class="max-w-5xl mx-auto px-4 py-12">
    <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900">Setups des streamers</h1>
    <p class="mt-3 text-gray-500">Le matos des pros, détaillé pièce par pièce — avec l'alternative budget pour chaque produit.</p>
    <div class="mt-8 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        streamers.map((s) => (
          <a href={`/streamers/${s.slug}/`} class="card-aesthetic p-6 block group text-center">
            <div class="w-24 h-24 mx-auto mb-4 rounded-full overflow-hidden border-4 border-pink-100 shadow-md">
              <img src={s.image} alt={s.nom} class="w-full h-full object-cover" loading="lazy" />
            </div>
            <h2 class="text-xl font-extrabold text-gray-900 group-hover:text-pink-500 transition-colors">{s.nom}</h2>
            <p class="text-sm text-gray-500 mt-2 line-clamp-2">{s.bio}</p>
            <span class="mt-4 inline-block text-sm font-bold text-pink-500 group-hover:translate-x-1 transition-transform">Voir son setup →</span>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>
