---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeoSchema from '../../components/SeoSchema.astro';
import streamers from '../../data/streamers.json';

const esport = ['gotaga', 'squeezie', 'kameto', 'zywoo', 'locklear'];


const faq = [
  { question: "Ces sélections montrent-elles le matériel officiel des créateurs ?", answer: "Les fiches proposent des inspirations de setup et des suggestions de matériel. Elles ne constituent pas un inventaire vérifié des équipements utilisés par chaque créateur." },
  { question: "Comment choisir un micro pour mon stream ?", answer: "Compare la connectique, les accessoires nécessaires et les contraintes de ta pièce. Nos guides permettent de comprendre les différences entre les produits." },
  { question: "Comment adapter mon setup à mon budget ?", answer: "Commence par tes besoins essentiels : son, image et éclairage. Le configurateur rassemble des sélections par budget, avec les prix à vérifier chez le vendeur." },
];
---

<BaseLayout
  title="Inspirations setup : streamers et créateurs Twitch et YouTube"
  description="Des idées de micros, caméras, périphériques et éclairages pour composer un setup inspiré des univers des créateurs."
>
  <SeoSchema slot="head" type="FAQPage" faq={faq} />
  <div class="max-w-5xl mx-auto px-4 py-12">
    <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900">Des inspirations pour ton setup de stream</h1>
    <p class="mt-4 text-gray-600 max-w-3xl leading-relaxed">
      Explore des idées de matériel et des alternatives pour composer ton propre espace, inspiré des univers de créateurs Twitch et YouTube. Ces sélections sont des suggestions, sans attribution de matériel officiel. Tu débutes ? Utilise notre <a href="/configurateur/" class="text-pink-600 font-bold hover:underline">configurateur de budget ↗</a> ou lis nos <a href="/articles/" class="text-pink-600 font-bold hover:underline">guides d'achat ↗</a>.
    </p>

    <h2 class="mt-12 mb-5 text-xl font-extrabold text-gray-900">Les figures de l'Esport & FPS</h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        streamers.filter((s) => esport.includes(s.slug)).map((s) => (
          <a href={`/streamers/${s.slug}/`} class="card-aesthetic p-6 block group text-center">
            <div class="w-24 h-24 mx-auto mb-4 rounded-full overflow-hidden border-4 border-pink-100 shadow-md">
              <img src={s.image} alt={s.nom} class="w-full h-full object-cover" loading="lazy" />
            </div>
            <h3 class="text-xl font-extrabold text-gray-900 group-hover:text-pink-500 transition-colors">{s.nom}</h3>
            <p class="text-xs text-gray-400 mt-1">{s.jeu_principal}</p>
            <div class="mt-3 flex flex-wrap justify-center gap-1.5">
              {(s.setup || []).slice(0, 3).map((p) => (
                <span class="text-[10px] font-bold text-gray-600 bg-pink-50 border border-pink-100 px-2 py-0.5 rounded-full">{p.nom.split(' ')[0]} {p.nom.split(' ').slice(1,3).join(' ')}</span>
              ))}
            </div>
            <span class="mt-4 inline-block text-sm font-bold text-pink-500 group-hover:translate-x-1 transition-transform">Voir l'inspiration →</span>
          </a>
        ))
      }
    </div>

    <h2 class="mt-12 mb-5 text-xl font-extrabold text-gray-900">Cozy, Variété & Just Chatting</h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        streamers.filter((s) => !esport.includes(s.slug)).map((s) => (
          <a href={`/streamers/${s.slug}/`} class="card-aesthetic p-6 block group text-center">
            <div class="w-24 h-24 mx-auto mb-4 rounded-full overflow-hidden border-4 border-pink-100 shadow-md">
              <img src={s.image} alt={s.nom} class="w-full h-full object-cover" loading="lazy" />
            </div>
            <h3 class="text-xl font-extrabold text-gray-900 group-hover:text-pink-500 transition-colors">{s.nom}</h3>
            <p class="text-xs text-gray-400 mt-1">{s.jeu_principal}</p>
            <div class="mt-3 flex flex-wrap justify-center gap-1.5">
              {(s.setup || []).slice(0, 3).map((p) => (
                <span class="text-[10px] font-bold text-gray-600 bg-purple-50 border border-purple-100 px-2 py-0.5 rounded-full">{p.nom.split(' ')[0]} {p.nom.split(' ').slice(1,3).join(' ')}</span>
              ))}
            </div>
            <span class="mt-4 inline-block text-sm font-bold text-pink-500 group-hover:translate-x-1 transition-transform">Voir l'inspiration →</span>
          </a>
        ))
      }
    </div>

    <section class="mt-14">
      <h2 class="text-2xl font-extrabold text-gray-900 mb-5">Questions fréquentes sur les setups de streamers</h2>
      <div class="space-y-3">
        {faq.map((f) => (
          <details class="card-aesthetic p-5 group">
            <summary class="font-bold text-gray-900 cursor-pointer list-none flex items-center justify-between">{f.question}<span class="text-pink-400 group-open:rotate-180 transition-transform">▾</span></summary>
            <p class="mt-3 text-sm text-gray-600 leading-relaxed">{f.answer}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
