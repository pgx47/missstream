---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeoSchema from '../../components/SeoSchema.astro';
import { amazonUrl } from '../../site.config';
import streamers from '../../data/streamers.json';

export function getStaticPaths() {
  return streamers.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}

const { s } = Astro.props;
const cats = [...new Set(s.setup.map((p) => p.cat))];
const CAT_GUIDE: Record<string, string> = {
  Audio: 'meilleur-micro-usb-blanc-pour-streamer',
  'PC & Image': 'webcam-4k-stream-rendu-net-et-lumineux',
  'Périphériques': 'clavier-mecanique-pastel-blanc-compact',
  'Éclairage': 'ring-light-led-setup-streaming',
};
const micro = s.setup.find((p) => p.cat === 'Audio') || s.setup[0];
const souris = s.setup.find((p) => p.cat === 'Périphériques');
const faq = [
  { q: `Quel micro utilise ${s.nom} ?`, a: `${s.nom} utilise le ${micro.nom}. ${micro.avis}` },
  ...(souris ? [{ q: `Quelle souris/périphérique utilise ${s.nom} ?`, a: `${s.nom} utilise le ${souris.nom}. ${souris.avis}` }] : []),
  { q: `Quel budget pour reproduire le setup de ${s.nom} ?`, a: `Le setup complet avoisine 800–2 000 € selon les pièces. Nos alternatives budget permettent de s'en approcher pour environ 300–500 € sans sacrifier le rendu caméra.` },
];
---

<BaseLayout
  title={`Setup de ${s.nom} (2026) : Matériel, Périphériques & Alternatives`}
  description={`Découvrez la liste complète du matériel de ${s.nom} : micro, casque, souris, caméra et les alternatives abordables pour reproduire son setup.`}
>
  <SeoSchema slot="head" type="FAQ" faq={faq} />
  <div class="max-w-5xl mx-auto px-4 py-12">
    <div class="flex flex-col sm:flex-row items-center gap-6 text-center sm:text-left">
      <div class="w-24 h-24 rounded-full overflow-hidden border-4 border-pink-100 shadow-md shrink-0">
        <img loading="lazy" decoding="async" src={s.image} alt={s.nom} class="w-full h-full object-cover" />
      </div>
      <div>
        <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900">Setup de {s.nom}</h1>
        <p class="mt-2 text-gray-500">{s.bio}</p>
        <div class="mt-3 flex flex-wrap justify-center sm:justify-start gap-2">
          {
            Object.entries(s.reseaux).map(([r, h]) => (
              <span class="text-xs font-bold px-3 py-1 rounded-full bg-purple-50 text-purple-600 border border-purple-100 capitalize">{r}</span>
            ))
          }
        </div>
      </div>
    </div>

    <div class="mt-8 max-w-3xl space-y-4 text-gray-600 leading-relaxed">
      {(s.biographie_longue || s.description_longue).split('\n\n').map((p: string) => <p>{p}</p>)}
    </div>

    <div class="mt-8 card-aesthetic overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-pink-50/60">
              <th class="px-4 py-3 font-extrabold text-gray-900">Catégorie</th>
              <th class="px-4 py-3 font-extrabold text-gray-900">Équipement officiel</th>
              <th class="px-4 py-3 font-extrabold text-gray-900">Alternative budget</th>
            </tr>
          </thead>
          <tbody>
            {
              s.setup.map((p) => (
                <tr class="border-t border-gray-100">
                  <td class="px-4 py-3 font-bold text-purple-600 whitespace-nowrap">{p.cat}</td>
                  <td class="px-4 py-3">
                    <a href={amazonUrl({ asin: p.asin, query: p.nom })} target="_blank" rel="nofollow sponsored noopener" class="text-gray-800 font-semibold hover:text-pink-600">{p.nom}</a>
                  </td>
                  <td class="px-4 py-3">
                    {p.dupe ? (
                      <a href={amazonUrl({ asin: p.dupe.asin, query: p.dupe.nom })} target="_blank" rel="nofollow sponsored noopener" class="text-pink-600 font-semibold hover:underline">{p.dupe.nom}</a>
                    ) : <span class="text-gray-400">—</span>}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>

    <div class="mt-10 flex gap-2 flex-wrap" id="tabs">
      <button data-cat="all" class="tab-btn px-4 py-2 rounded-xl text-sm font-bold bg-gradient-to-r from-pink-500 to-rose-400 text-white">Tout</button>
      {
        cats.map((c) => (
          <button data-cat={c} class="tab-btn px-4 py-2 rounded-xl text-sm font-bold bg-white text-gray-600 border border-pink-100">{c}</button>
        ))
      }
    </div>

    <div class="mt-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        s.setup.map((p) => (
          <div class="prod card-aesthetic overflow-hidden flex flex-col" data-cat={p.cat}>
            {p.asin && (
              <div class="h-40 bg-surface-bg flex items-center justify-center p-4">
                <img src={`/images/products/${p.asin}.webp`} alt={p.nom} class="h-full object-contain" loading="lazy" />
              </div>
            )}
            <div class="p-5 flex-1 flex flex-col">
              <p class="text-[10px] font-extrabold uppercase tracking-widest text-purple-500">{p.cat}</p>
              <h3 class="mt-1 font-extrabold text-gray-900">{p.nom}</h3>
              <a
                href={amazonUrl({ asin: p.asin, query: p.nom })}
                target="_blank"
                rel="nofollow sponsored noopener"
                class="btn-cta mt-3 text-center px-4 py-2.5 text-sm"
              >
                Voir sur Amazon
              </a>
              {p.dupe && (
                <div class="mt-3 rounded-xl bg-pink-50/50 border border-pink-100 p-3">
                  <p class="text-[10px] font-extrabold uppercase tracking-widest text-pink-500">Alternative budget</p>
                  {p.dupe.asin && (
                    <div class="mt-2 flex items-center gap-2.5">
                      <img src={`/images/products/${p.dupe.asin}.webp`} alt={p.dupe.nom} class="w-10 h-10 rounded-lg object-contain bg-white border border-pink-100 p-0.5" loading="lazy" />
                      <p class="text-sm font-bold text-gray-800 flex-1">{p.dupe.nom}</p>
                    </div>
                  )}
                  {!p.dupe.asin && <p class="text-sm font-bold text-gray-800 mt-0.5">{p.dupe.nom}</p>}
                  <a
                    href={amazonUrl({ asin: p.dupe.asin, query: p.dupe.nom })}
                    target="_blank"
                    rel="nofollow sponsored noopener"
                    class="mt-1.5 inline-block text-xs font-extrabold text-pink-600 hover:underline"
                  >
                    Voir l'alternative →
                  </a>
                </div>
              )}
              <p class="mt-3 pt-3 border-t border-gray-100 text-xs text-gray-400 leading-relaxed flex-1">
                L'avis Miss Stream : {p.avis}
              </p>
              {CAT_GUIDE[p.cat] && (
                <a href={`/articles/${CAT_GUIDE[p.cat]}/`} class="mt-2 text-xs font-bold text-purple-500 hover:underline">
                  Voir notre comparatif {p.cat.toLowerCase()} →
                </a>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>

    <section class="mt-12">
      <h2 class="text-2xl font-extrabold text-gray-900 mb-6">FAQ sur le setup de {s.nom}</h2>
      <div class="space-y-3">
        {faq.map((f) => (
          <details class="card-aesthetic p-5 group">
            <summary class="font-bold text-gray-800 cursor-pointer list-none flex items-center justify-between">
              {f.q}
              <span class="text-pink-400 group-open:rotate-180 transition-transform">▾</span>
            </summary>
            <p class="mt-3 text-sm text-gray-600 leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

  <script is:inline>
    document.querySelectorAll('.tab-btn').forEach((b) => {
      b.addEventListener('click', () => {
        const c = b.dataset.cat;
        document.querySelectorAll('.prod').forEach((el) => {
          el.classList.toggle('hidden', c !== 'all' && el.dataset.cat !== c);
        });
        document.querySelectorAll('.tab-btn').forEach((x) => {
          x.className = x === b
            ? 'tab-btn px-4 py-2 rounded-xl text-sm font-bold bg-gradient-to-r from-pink-500 to-rose-400 text-white'
            : 'tab-btn px-4 py-2 rounded-xl text-sm font-bold bg-white text-gray-600 border border-pink-100';
        });
      });
    });
  </script>
</BaseLayout>
