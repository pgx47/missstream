---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { resolveUpdatedDate } from '../../utils/lastmod';

export async function getStaticPaths() {
  const news = await getCollection('news', ({ data }) => !data.draft);
  return news.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const related = (
  await getCollection('guides', ({ data }) => !data.draft)
)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3)
  .map((g) => ({ title: g.data.title, href: `/articles/${g.id}/`, image: g.data.image }));

const updatedDate = resolveUpdatedDate(
  'news',
  entry.id,
  entry.data.publishDate,
);
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  image={entry.data.image}
  publishDate={entry.data.publishDate}
  updatedDate={updatedDate}
  section="Actualités"
  sectionHref="/actualites/"
  headings={headings}
  related={related}
>
  {
    entry.data.sourceUrl && (
      <p class="mb-6 text-sm">
        <a
          href={entry.data.sourceUrl}
          target="_blank"
          rel="nofollow noopener"
          class="inline-flex items-center gap-1 text-purple-600 font-semibold hover:underline"
        >
          Source de l'information ↗
        </a>
      </p>
    )
  }
  <Content />
</ArticleLayout>
