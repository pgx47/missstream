---
import BaseLayout from '../../layouts/BaseLayout.astro';
import items from '../../data/deco_items.json';

const cats = [
  { id: 'all', label: 'Tout' },
  { id: 'lumieres', label: '💡 Lumières & Néons' },
  { id: 'kawaii', label: '🧸 Kawaii & Cozy' },
  { id: 'gadgets-y2k', label: '📟 Gadgets Y2K' },
];
const url = (a: string) => `https://www.amazon.fr/dp/${a}?tag=missstrm-21`;
---

<BaseLayout
  title="Déco & Accessoires de Stream | Miss Stream"
  description="Les objets esthétiques pour un fond de caméra unique : lava lamps, néons, projecteurs, gadgets Y2K."
>
  <div class="max-w-6xl mx-auto px-4 py-12">
    <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900">Déco & Accessoires de Stream</h1>
    <p class="mt-3 text-gray-500 max-w-2xl">Lampes d'ambiance, néons, rangements et gadgets esthétiques pour habiller ton fond de caméra.</p>

    <div id="filters" class="mt-6 flex flex-wrap gap-2">
      {cats.map((c) => (
        <button data-cat={c.id} class:list={["deco-filter px-4 py-2 rounded-full text-sm font-bold border transition-colors", c.id === 'all' ? 'bg-pink-500 text-white border-pink-500' : 'bg-white text-gray-600 border-pink-100 hover:border-pink-300']}>
          {c.label}
        </button>
      ))}
    </div>

    <div id="grid" class="mt-8 grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
      {items.map((p) => (
        <a href={url(p.asin)} data-cat={p.cat} target="_blank" rel="nofollow sponsored noopener"
           class="deco-item card-aesthetic !p-4 flex flex-col items-center text-center group">
          <div class="w-full aspect-square bg-slate-50/70 rounded-xl p-3 flex items-center justify-center border border-pink-50 relative">
            {p.badge && <span class="absolute top-2 left-2 bg-pink-100 text-pink-600 text-[9px] font-extrabold uppercase px-2 py-0.5 rounded-full">{p.badge}</span>}
            <img
              src={`/images/products/${p.asin}.webp`}
              onerror={`this.onerror=null;this.src='https://m.media-amazon.com/images/P/${p.asin}.01._SCLZZZZZZZ_SX400_.jpg'`}
              alt={p.nom} loading="lazy" decoding="async" referrerpolicy="no-referrer"
              class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-300"
            />
          </div>
          <p class="mt-3 text-sm font-extrabold text-gray-900 leading-snug line-clamp-2 min-h-[2.5rem]">{p.nom}</p>
          <p class="text-xs text-gray-500 mt-1 line-clamp-2">{p.desc}</p>
          <p class="mt-1 text-sm font-black text-rose-500">{p.prix}</p>
          <span class="mt-3 w-full text-center px-4 py-2.5 rounded-xl bg-gradient-to-r from-pink-500 to-rose-400 !text-white !no-underline font-extrabold text-xs shadow-md group-hover:shadow-lg transition-all">Voir sur Amazon ↗</span>
        </a>
      ))}
    </div>
  </div>

  <script>
    document.querySelectorAll('.deco-filter').forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-cat');
        document.querySelectorAll('.deco-filter').forEach((b) => {
          const on = b === btn;
          b.className = b.className.replace(/bg-pink-500 text-white border-pink-500|bg-white text-gray-600 border-pink-100 hover:border-pink-300/g, '') +
            (on ? ' bg-pink-500 text-white border-pink-500' : ' bg-white text-gray-600 border-pink-100 hover:border-pink-300');
        });
        document.querySelectorAll('.deco-item').forEach((el) => {
          (el as HTMLElement).style.display = (cat === 'all' || el.getAttribute('data-cat') === cat) ? '' : 'none';
        });
      });
    });
  </script>
</BaseLayout>
