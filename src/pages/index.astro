---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SeoSchema from '../components/SeoSchema.astro';
import DealCard from '../components/DealCard.astro';
import { SITE } from '../site.config';
import deals from '../data/deals.json';

const guides = (await getCollection('guides', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);
const news = (await getCollection('news', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const featured = guides[0];
const rest = guides.slice(1, 7);
const dateFmt = (d: Date) =>
  d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title={SITE.name} description={SITE.description}>
  <SeoSchema slot="head" type="WebSite" />

  <section class="relative pt-12 pb-20 md:pt-20 md:pb-28 overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-8 items-center">
        <div class="text-left z-10">
          <span
            class="inline-flex items-center gap-1.5 px-3 py-1 mb-6 text-xs font-bold uppercase tracking-widest text-pink-600 bg-pink-100 rounded-full border border-pink-200"
          >
            Guides & bons plans setup
          </span>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-gray-900 tracking-tight leading-[1.1] mb-6">
            Un setup de stream <br class="hidden sm:block" />
            <span class="bg-gradient-to-r from-pink-500 to-purple-500 bg-clip-text text-transparent">aussi beau</span>
            que performant
          </h1>
          <p class="text-lg text-gray-600 mb-8 max-w-lg leading-relaxed">
            Micros, casques, chaises, LED pastel : on teste, on compare et on déniche les
            meilleurs rapports qualité-esthétique-prix pour créatrices de contenu.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a
              href="/articles/"
              class="btn-cta inline-flex justify-center items-center px-8 py-4 text-base"
              >Voir les guides</a
            >
            <a
              href="/bons-plans/"
              class="inline-flex justify-center items-center px-8 py-4 text-base font-bold text-pink-600 bg-white border-2 border-pink-100 rounded-xl hover:bg-pink-50 transition-colors"
              >Bons plans du jour</a
            >
          </div>
        </div>

        <div class="relative lg:h-[500px] flex justify-center lg:justify-end z-10">
          <div
            class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120%] aspect-square bg-gradient-to-tr from-pink-100 to-purple-50 rounded-full blur-3xl opacity-60 -z-10"
          >
          </div>
          <div
            class="relative w-full max-w-md lg:max-w-none lg:w-[110%] rounded-2xl shadow-2xl overflow-hidden border-4 border-white rotate-2 hover:rotate-0 transition-transform duration-500"
          >
            <img
              src="/images/hero-setup.webp"
              alt="Setup de streaming pastel esthétique"
              class="w-full h-full object-cover aspect-[4/3] lg:aspect-auto"
              loading="eager"
            />
          </div>
          <div
            class="absolute -bottom-6 -left-6 bg-white p-4 rounded-xl shadow-xl border border-gray-100 animate-bounce-slow hidden sm:block"
          >
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 bg-purple-100 rounded-full flex items-center justify-center">
                <svg class="w-5 h-5 text-purple-500" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 14a3 3 0 003-3V6a3 3 0 10-6 0v5a3 3 0 003 3z" />
                  <path d="M19 11a7 7 0 01-14 0H3a9 9 0 008 8.94V22H8v2h8v-2h-3v-2.06A9 9 0 0021 11h-2z" />
                </svg>
              </div>
              <div>
                <p class="text-xs text-gray-500 uppercase tracking-wide font-bold">Nouveau test</p>
                <p class="text-sm font-bold text-gray-900">Micros blancs comparés</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    .animate-bounce-slow {
      animation: bounce 3s infinite;
    }
  </style>

  <section class="max-w-6xl mx-auto px-4 pb-14">
    <div class="text-center max-w-xl mx-auto mb-8">
      <span class="badge-guide mb-2 inline-block">Outils gratuits</span>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900">Tout pour créer ton espace de stream</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <a href="/configurateur/" class="card-aesthetic p-6 relative group overflow-hidden block">
        <span class="absolute top-4 right-4 bg-pink-500 text-white text-[10px] font-extrabold uppercase px-2.5 py-0.5 rounded-full">Top conversion</span>
        <div class="w-12 h-12 rounded-2xl bg-pink-100 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
          <svg class="w-6 h-6 text-pink-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 11-3 0m3 0a1.5 1.5 0 10-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-9.75 0h9.75"/></svg>
        </div>
        <h3 class="text-lg font-extrabold text-gray-900 mb-2 group-hover:text-pink-500 transition-colors">Configurateur de budget</h3>
        <p class="text-sm text-gray-600 mb-4 leading-relaxed">Choisis ton budget (150 €, 400 € ou 900 €) et découvre le pack complet prêt à brancher.</p>
        <span class="text-sm font-bold text-pink-500 inline-flex items-center gap-1 group-hover:translate-x-1 transition-transform">Lancer la simulation →</span>
      </a>
      <a href="/lookbook/" class="card-aesthetic p-6 relative group overflow-hidden block">
        <div class="w-12 h-12 rounded-2xl bg-purple-100 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
          <svg class="w-6 h-6 text-purple-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5"/></svg>
        </div>
        <h3 class="text-lg font-extrabold text-gray-900 mb-2 group-hover:text-purple-500 transition-colors">Le Lookbook Setup</h3>
        <p class="text-sm text-gray-600 mb-4 leading-relaxed">Plein d'idées de bureaux pastel et minimalistes. Clique sur une photo pour copier le setup.</p>
        <span class="text-sm font-bold text-purple-500 inline-flex items-center gap-1 group-hover:translate-x-1 transition-transform">Explorer les styles →</span>
      </a>
      <a href="/checklist/" class="card-aesthetic p-6 relative group overflow-hidden block">
        <div class="w-12 h-12 rounded-2xl bg-rose-100 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
          <svg class="w-6 h-6 text-rose-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <h3 class="text-lg font-extrabold text-gray-900 mb-2 group-hover:text-rose-500 transition-colors">Checklist Avant-Live</h3>
        <p class="text-sm text-gray-600 mb-4 leading-relaxed">Huit étapes indispensables mémorisées dans ton navigateur pour lancer ton stream sans stress.</p>
        <span class="text-sm font-bold text-rose-500 inline-flex items-center gap-1 group-hover:translate-x-1 transition-transform">Vérifier mon setup →</span>
      </a>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-12">
    <div class="flex items-end justify-between mb-6">
      <h2 class="text-2xl font-extrabold text-gray-900">Guides récents</h2>
      <a href="/articles/" class="text-sm font-semibold text-pink-600 hover:underline">Tout voir →</a>
    </div>

    {
      featured && (
        <a
          href={`/articles/${featured.id}/`}
          class="group block md:grid md:grid-cols-2 gap-0 card-aesthetic overflow-hidden mb-8"
        >
          <img
            src={featured.data.image}
            alt={featured.data.title}
            class="w-full h-56 md:h-full object-cover"
            loading="eager"
          />
          <div class="p-6 md:p-8 flex flex-col justify-center">
            <span class="text-xs font-bold text-pink-500 uppercase tracking-widest">
              À la une · {dateFmt(featured.data.publishDate)}
            </span>
            <h3 class="mt-3 text-2xl font-extrabold text-gray-900 group-hover:text-pink-600 transition-colors leading-snug">
              {featured.data.title}
            </h3>
            <p class="mt-3 text-gray-500 leading-relaxed">{featured.data.description}</p>
          </div>
        </a>
      )
    }

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {
        rest.map((g) => (
          <a
            href={`/articles/${g.id}/`}
            class="group card-aesthetic overflow-hidden"
          >
            <img src={g.data.image} alt={g.data.title} class="w-full h-40 object-cover" loading="lazy" />
            <div class="p-5">
              <span class="text-xs font-bold text-pink-500 uppercase tracking-widest">
                {dateFmt(g.data.publishDate)}
              </span>
              <h3 class="mt-2 font-bold text-gray-900 leading-snug group-hover:text-pink-600 transition-colors">
                {g.data.title}
              </h3>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  {
    news.length > 0 && (
      <section class="max-w-6xl mx-auto px-4 py-12">
        <div class="flex items-end justify-between mb-6">
          <h2 class="text-2xl font-extrabold text-gray-900">Dernières actus</h2>
          <a href="/actualites/" class="text-sm font-semibold text-pink-600 hover:underline">
            Tout voir →
          </a>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {news.slice(0, 3).map((n) => (
            <a
              href={`/actualites/${n.id}/`}
              class="group card-aesthetic overflow-hidden"
            >
              <img src={n.data.image} alt={n.data.title} class="w-full h-36 object-cover" loading="lazy" />
              <div class="p-5">
                <span class="text-xs font-bold text-purple-500 uppercase tracking-widest">
                  {dateFmt(n.data.publishDate)}
                </span>
                <h3 class="mt-2 font-bold text-gray-900 leading-snug group-hover:text-purple-600 transition-colors">
                  {n.data.title}
                </h3>
              </div>
            </a>
          ))}
        </div>
      </section>
    )
  }

  {
    deals.length > 0 && (
      <section class="max-w-6xl mx-auto px-4 py-12">
        <div class="flex items-end justify-between mb-6">
          <h2 class="text-2xl font-extrabold text-gray-900">Bons plans repérés</h2>
          <a href="/bons-plans/" class="text-sm font-semibold text-pink-600 hover:underline">
            Tout voir →
          </a>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {deals.slice(0, 4).map((d) => (
            <DealCard nom={d.nom} asin={d.asin} categorie={d.categorie} badge={d.badge} note={d.note} image={d.image} stars={d.stars} avis={d.avis} />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
