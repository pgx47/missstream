---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SeoSchema from '../components/SeoSchema.astro';
import DealCard from '../components/DealCard.astro';
import AvantApres from '../components/AvantApres.astro';
import streamers from '../data/streamers.json';
import SeasonalBanner from '../components/SeasonalBanner.astro';

const topStreamers = streamers.filter((s) =>
  ['zywoo', 'pokimane', 'gotaga', 'maghla'].includes(s.slug)
);
import { SITE } from '../site.config';
import deals from '../data/deals.json';

const guides = (await getCollection('guides', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);
const news = (await getCollection('news', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const featured = guides[0];
const rest = guides.slice(1, 7);
const dateFmt = (d: Date) =>
  d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title={SITE.name} description={SITE.description}>
  <SeoSchema slot="head" type="WebSite" />
  <SeoSchema slot="head" type="Organization" />
  <link slot="head" rel="preload" as="image" href="/images/hero-setup.webp" fetchpriority="high" />

  <section class="relative pt-12 pb-20 md:pt-20 md:pb-28 overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-8 items-center">
        <div class="text-left z-10">
          <span
            class="inline-flex items-center gap-1.5 px-3 py-1 mb-6 text-xs font-bold uppercase tracking-widest text-pink-600 bg-pink-100 rounded-full border border-pink-200"
          >
            Guides & bons plans setup
          </span>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-gray-900 tracking-tight leading-[1.1] mb-6">
            Un setup de stream <br class="hidden sm:block" />
            <span class="bg-gradient-to-r from-pink-500 to-purple-500 bg-clip-text text-transparent">aussi beau</span>{' '}
            que performant
          </h1>
          <p class="text-lg text-gray-600 mb-8 max-w-lg leading-relaxed">
            Micros, casques, chaises, LED pastel : on teste, on compare et on déniche les
            meilleurs rapports qualité-esthétique-prix pour créatrices de contenu.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a
              href="/articles/"
              class="btn-cta inline-flex justify-center items-center px-8 py-4 text-base"
              >Voir les guides</a
            >
            <a
              href="/bons-plans/"
              class="inline-flex justify-center items-center px-8 py-4 text-base font-bold text-pink-600 bg-white border-2 border-pink-100 rounded-xl hover:bg-pink-50 transition-colors"
              >Bons plans du jour</a
            >
          </div>
          <p class="mt-4 text-xs text-gray-500">
            Tu ne sais pas quoi choisir ?{' '}
            <a href="/quiz/" class="font-extrabold text-pink-600 hover:underline">Fais le test en 3 clics →</a>
          </p>
        </div>

        <div class="relative lg:h-[500px] flex justify-center lg:justify-end z-10">
          <div
            class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120%] aspect-square bg-gradient-to-tr from-pink-100 to-purple-50 rounded-full blur-3xl opacity-60 -z-10"
          >
          </div>
          <div
            class="relative w-full max-w-md lg:max-w-none lg:w-[110%] rounded-2xl shadow-2xl overflow-hidden border-4 border-white rotate-2 hover:rotate-0 transition-transform duration-500"
          >
            <img
              src="/images/hero-setup.webp" fetchpriority="high" width="1200" height="900"
              alt="Setup de streaming pastel esthétique"
              class="w-full h-full object-cover aspect-[4/3] lg:aspect-auto"
              loading="eager"
            />
          </div>
          <div
            class="absolute -bottom-6 -left-6 bg-white p-4 rounded-xl shadow-xl border border-gray-100 animate-bounce-slow hidden sm:block"
          >
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 bg-purple-100 rounded-full flex items-center justify-center">
                <svg class="w-5 h-5 text-purple-500" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 14a3 3 0 003-3V6a3 3 0 10-6 0v5a3 3 0 003 3z" />
                  <path d="M19 11a7 7 0 01-14 0H3a9 9 0 008 8.94V22H8v2h8v-2h-3v-2.06A9 9 0 0021 11h-2z" />
                </svg>
              </div>
              <div>
                <p class="text-xs text-gray-500 uppercase tracking-wide font-bold">Nouveau test</p>
                <p class="text-sm font-bold text-gray-900">Micros blancs comparés</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <SeasonalBanner />

  <style>
    .animate-bounce-slow {
      animation: bounce 3s infinite;
    }
  </style>

  <section class="max-w-6xl mx-auto px-4 pb-14">
    <div class="text-center max-w-xl mx-auto mb-8">
      <div class="flex items-end justify-between">
        <div class="text-left"><span class="badge-guide mb-2 inline-block">BOÎTE À OUTILS CRÉATEURS</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900">Miss Stream : les outils indispensables pour ton live</h2>
        <p class="text-sm text-gray-500 mt-1">Panneaux Twitch sur-mesure, configurateur de budget et inspirations setup réunis au même endroit.</p></div>
        <a href="/outils/" class="text-sm font-semibold text-pink-600 hover:underline shrink-0">Tous les outils (6) →</a>
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Miss Stream Studio — vedette -->
      <a href="/outils/panneaux-twitch/" class="md:col-span-2 card-aesthetic relative overflow-hidden group flex flex-col justify-between bg-gradient-to-br from-pink-50 via-white to-purple-50 border-pink-200 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
        <span class="absolute top-4 right-4 bg-pink-500 text-white text-[10px] font-extrabold uppercase px-2.5 py-0.5 rounded-full z-10">Populaire · 100% gratuit</span>
        <div class="p-7 sm:p-8 grid sm:grid-cols-2 gap-6 items-center">
          <div>
            <h3 class="text-xl sm:text-2xl font-extrabold text-gray-900 group-hover:text-pink-500 transition-colors">Miss Stream Studio</h3>
            <p class="text-sm text-gray-600 mt-2 leading-relaxed">Générateur de panneaux Twitch pastel : presets, dégradés, polices, export ZIP instantané — sans compte.</p>
            <span class="mt-5 inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-pink-500 to-rose-400 text-white text-sm font-extrabold shadow-md">Ouvrir le studio →</span>
          </div>
          <div class="hidden sm:flex flex-col gap-3 items-stretch">
            <div class="rounded-xl bg-gradient-to-r from-pink-200 to-amber-100 shadow-md px-4 py-3 text-center text-xs font-extrabold text-pink-800 -rotate-2 group-hover:rotate-0 transition-transform">À PROPOS</div>
            <div class="rounded-xl bg-gradient-to-r from-purple-200 to-indigo-200 shadow-md px-4 py-3 text-center text-xs font-extrabold text-purple-800 rotate-1 group-hover:rotate-0 transition-transform">SETUP</div>
            <div class="rounded-xl bg-gradient-to-r from-emerald-100 to-teal-200 shadow-md px-4 py-3 text-center text-xs font-extrabold text-emerald-800 -rotate-1 group-hover:rotate-0 transition-transform">DISCORD</div>
          </div>
        </div>
      </a>
      <!-- Lookbook -->
      <a href="/lookbook/" class="md:col-span-1 card-aesthetic relative overflow-hidden group shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 min-h-[220px]">
        <img src="/images/outils/lookbook.webp" alt="Setup pastel" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" decoding="async" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
        <div class="absolute bottom-0 p-6">
          <p class="text-white font-extrabold text-lg">Le Lookbook Setup</p>
          <p class="text-pink-200 text-xs font-bold mt-0.5">Inspirations bureaux pastel — copie le look en 1 clic</p>
          <span class="mt-2 inline-block text-white text-xs font-extrabold">Explorer les inspirations →</span>
        </div>
      </a>
      <!-- Configurateur -->
      <a href="/configurateur/" class="md:col-span-1 group relative flex flex-col justify-between p-6 sm:p-8 bg-gradient-to-br from-purple-50 to-pink-50/30 border border-purple-100 rounded-2xl shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 overflow-hidden min-h-[220px]">
        <div class="absolute -right-6 -bottom-6 w-32 h-32 opacity-10 group-hover:opacity-20 group-hover:scale-110 group-hover:rotate-12 transition-all duration-500 pointer-events-none text-purple-600">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 11-3 0m3 0a1.5 1.5 0 10-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-9.75 0h9.75" /></svg>
        </div>
        <div class="z-10 relative">
          <h3 class="text-xl sm:text-2xl font-extrabold text-gray-900 mb-2">Configurateur de budget</h3>
          <p class="text-gray-500 text-sm sm:text-base max-w-[80%] mb-6">Le pack complet, du micro à la webcam, adapté à ton enveloppe.</p>
          <div class="flex flex-wrap gap-2 mb-6">
            <span class="inline-flex items-center bg-white border border-pink-100 text-pink-600 text-xs font-bold px-3 py-1.5 rounded-lg shadow-sm">150 €</span>
            <span class="inline-flex items-center bg-white border border-purple-100 text-purple-600 text-xs font-bold px-3 py-1.5 rounded-lg shadow-sm">400 €</span>
            <span class="inline-flex items-center bg-white border border-amber-100 text-amber-600 text-xs font-bold px-3 py-1.5 rounded-lg shadow-sm">900 €</span>
          </div>
        </div>
        <div class="z-10 mt-auto flex items-center justify-between">
          <span class="text-sm font-bold text-pink-500 group-hover:text-rose-500 transition-colors">Lancer la simulation</span>
          <div class="flex items-center justify-center w-8 h-8 rounded-full bg-white text-pink-500 group-hover:bg-rose-500 group-hover:text-white transition-colors shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
          </div>
        </div>
      </a>
      <!-- Dupes -->
      <a href="/dupes/" class="md:col-span-2 card-aesthetic p-6 sm:p-8 group shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col sm:flex-row sm:items-center justify-between gap-4 relative overflow-hidden min-h-[140px]">
        <div class="absolute right-0 top-0 w-1/2 h-full opacity-15 group-hover:opacity-25 transition-opacity pointer-events-none z-0" style="mask-image:linear-gradient(to left,black,transparent);-webkit-mask-image:linear-gradient(to left,black,transparent);">
          <img src="/images/lookbook/cosmic-stream.webp" class="w-full h-full object-cover object-right" alt="" loading="lazy" />
        </div>
        <div class="relative z-10 flex-1">
          <span class="bg-amber-400 text-white text-[10px] font-extrabold uppercase px-2.5 py-0.5 rounded-full shadow-sm">Bons plans</span>
          <h3 class="text-xl sm:text-2xl font-extrabold text-gray-900 mt-2 group-hover:text-pink-500 transition-colors">Le Chasseur de Dupes</h3>
          <p class="text-sm sm:text-base text-gray-600 mt-1 leading-relaxed max-w-md">Le même rendu audio et visuel sans payer la taxe premium des grandes marques.</p>
        </div>
        <div class="relative z-10 flex items-center gap-4 shrink-0">
          <div class="text-right">
            <span class="block text-[10px] uppercase font-semibold text-gray-400">Ex. setup complet</span>
            <span class="text-sm text-gray-400 line-through">399 €</span>
            <span class="text-3xl font-black text-rose-500 ml-1.5">159 €</span>
          </div>
          <div class="w-12 h-12 rounded-full bg-pink-50 text-pink-500 group-hover:bg-rose-500 group-hover:text-white transition-colors flex items-center justify-center shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
          </div>
        </div>
      </a>
    </div>
  </section>

  <a href="/configurateur/" class="block card-aesthetic mb-14 p-5 sm:p-6 bg-gradient-to-r from-pink-50 via-white to-purple-50 border-pink-200 group hover:shadow-lg transition-all">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div>
        <span class="badge-guide mb-1 inline-block">Tout-en-un</span>
        <p class="font-extrabold text-gray-900 group-hover:text-pink-500 transition-colors">Tu débutes ? Setup complet pré-configuré dès 150 €</p>
        <p class="text-xs text-gray-500">Pack prêt à brancher : 150 € · 400 € · 900 €</p>
      </div>
      <span class="btn-cta shrink-0 px-5 py-2.5 text-sm text-center">Voir les packs →</span>
    </div>
  </a>

  <section class="max-w-6xl mx-auto px-4 pb-12 border-t border-pink-50 pt-12">
    <div class="flex flex-col sm:flex-row items-center justify-between mb-8 gap-4">
      <div>
        <span class="badge-guide mb-2 inline-block">ProSettings</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900">Le matos des Pros & Créatrices</h2>
      </div>
      <a href="/streamers/" class="shrink-0 px-5 py-2.5 rounded-xl bg-purple-50 text-purple-600 font-bold hover:bg-purple-100 transition-colors">
        Voir tous les setups →
      </a>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {topStreamers.map((st) => (
        <a href={`/streamers/${st.slug}/`} class="group relative rounded-2xl overflow-hidden aspect-square bg-gray-100 shadow-sm hover:shadow-md transition-all">
          <img src={st.image} alt={st.nom} class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
          <div class="absolute bottom-0 inset-x-0 p-4">
            <p class="text-white font-extrabold text-lg">{st.nom}</p>
            <p class="text-pink-300 text-xs font-bold uppercase tracking-wider">{st.jeu_principal}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 pb-12">
    <div class="text-center mb-6">
      <span class="badge-guide mb-2 inline-block">La preuve par l'image</span>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900">Avant / Après</h2>
    </div>
    <AvantApres
      avant="/images/lookbook/avant.webp"
      apres="/images/lookbook/apres.webp"
      items={[
        { nom: 'Barre lumineuse écran', query: 'barre lumineuse ecran' },
        { nom: 'Tapis XXL pastel', asin: 'B0H6M26Z8C' },
        { nom: 'Passe-câbles sous plateau', query: 'passe cables bureau' },
      ]}
    />
  </section>

  <section class="max-w-6xl mx-auto px-4 py-12">
    <div class="flex items-end justify-between mb-6">
      <h2 class="text-2xl font-extrabold text-gray-900">Guides récents</h2>
      <a href="/articles/" class="text-sm font-semibold text-pink-600 hover:underline">Tout voir →</a>
    </div>

    {
      featured && (
        <a
          href={`/articles/${featured.id}/`}
          class="group block md:grid md:grid-cols-2 gap-0 card-aesthetic overflow-hidden mb-8"
        >
          <img
            src={featured.data.image}
            alt={featured.data.title}
            class="w-full h-56 md:h-full object-cover"
            loading="eager"
          />
          <div class="p-6 md:p-8 flex flex-col justify-center">
            <span class="text-xs font-bold text-pink-500 uppercase tracking-widest">
              À la une · {dateFmt(featured.data.publishDate)}
            </span>
            <h3 class="mt-3 text-2xl font-extrabold text-gray-900 group-hover:text-pink-600 transition-colors leading-snug">
              {featured.data.title}
            </h3>
            <p class="mt-3 text-gray-500 leading-relaxed">{featured.data.description}</p>
          </div>
        </a>
      )
    }

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {
        rest.map((g) => (
          <a
            href={`/articles/${g.id}/`}
            class="group card-aesthetic overflow-hidden"
          >
            <img src={g.data.image || '/images/hero-setup.webp'} onerror="this.onerror=null;this.src='/images/hero-setup.webp'" alt={g.data.title} class="w-full h-40 object-cover" loading="lazy" />
            <div class="p-5">
              <span class="text-xs font-bold text-pink-500 uppercase tracking-widest">
                {dateFmt(g.data.publishDate)}
              </span>
              <h3 class="mt-2 font-bold text-gray-900 leading-snug group-hover:text-pink-600 transition-colors">
                {g.data.title}
              </h3>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-12">
    <div class="text-center max-w-xl mx-auto mb-8">
      <span class="badge-guide mb-2 inline-block">Copier ce look</span>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900">🌸 Inspirations Déco & Setups</h2>
      <p class="text-sm text-gray-500 mt-2">Copiez les plus beaux bureaux de stream en un clic — lumières, accessoires, ambiance.</p>
    </div>
    <div class="grid sm:grid-cols-3 gap-5">
      {[
        { titre: 'Setup Pink Kawaii', img: '/images/lookbook/studio-pastel-streaming.webp' },
        { titre: 'Cosmic Stream', img: '/images/lookbook/cosmic-stream.webp' },
        { titre: 'Retro Y2K', img: '/images/lookbook/retro-aesthetic.webp' },
      ].map((t) => (
        <a href="/lookbook/" class="group relative rounded-2xl overflow-hidden aspect-[4/3] shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
          <img src={t.img} alt={t.titre} class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" decoding="async" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent"></div>
          <div class="absolute bottom-0 p-4 w-full flex items-center justify-between">
            <span class="font-extrabold text-white drop-shadow">{t.titre}</span>
            <span class="text-[11px] font-extrabold text-white bg-pink-500/90 px-2.5 py-1 rounded-full">Voir les objets ↗</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  {
    news.length > 0 && (
      <section class="max-w-6xl mx-auto px-4 py-12">
        <div class="flex items-end justify-between mb-6">
          <h2 class="text-2xl font-extrabold text-gray-900">Dernières actus</h2>
          <a href="/actualites/" class="text-sm font-semibold text-pink-600 hover:underline">
            Tout voir →
          </a>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {news.slice(0, 3).map((n) => (
            <a
              href={`/actualites/${n.id}/`}
              class="group card-aesthetic overflow-hidden"
            >
              <img src={n.data.image} alt={n.data.title} class="w-full h-36 object-cover" loading="lazy" />
              <div class="p-5">
                <span class="text-xs font-bold text-purple-500 uppercase tracking-widest">
                  {dateFmt(n.data.publishDate)}
                </span>
                <h3 class="mt-2 font-bold text-gray-900 leading-snug group-hover:text-purple-600 transition-colors">
                  {n.data.title}
                </h3>
              </div>
            </a>
          ))}
        </div>
      </section>
    )
  }

  {
    deals.length > 0 && (
      <section class="max-w-6xl mx-auto px-4 py-12">
        <div class="flex items-end justify-between mb-6">
          <h2 class="text-2xl font-extrabold text-gray-900">Bons plans repérés</h2>
          <a href="/bons-plans/" class="text-sm font-semibold text-pink-600 hover:underline">
            Tout voir →
          </a>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {deals.slice(0, 4).map((d) => (
            <DealCard nom={d.nom} asin={d.asin} categorie={d.categorie} badge={d.badge} note={d.note} image={d.image} stars={d.stars} avis={d.avis} />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
