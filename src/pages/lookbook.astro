---
import BaseLayout from '../layouts/BaseLayout.astro';
import { amazonUrl } from '../site.config';
import ambiances from '../data/lookbook.json';

const _ambiances = [
  {
    titre: 'Le Classique Pink & White',
    image: '/images/lookbook/pink-white.webp',
    description: 'Le setup le plus populaire sur TikTok. Doux, lumineux, parfait pour le Just Chatting.',
    produits: [
      { nom: 'Clavier Logitech G715 blanc', asin: 'B099XG1QNV' },
      { nom: 'Micro Fifine AM8 blanc', asin: 'B0C74G9RLH' },
      { nom: 'Tapis de souris XXL pastel', asin: 'B0H6M26Z8C' },
    ],
  },
  {
    titre: 'L\'Épuré Minimaliste',
    image: '/images/lookbook/minimal.webp',
    description: 'Zéro câble visible. Un espace qui respire pour le stream de jeux indés.',
    produits: [
      { nom: 'Bras de micro Elgato Wave LP blanc', asin: 'B097376LKF' },
      { nom: 'Webcam Logitech Brio 500 blanche', asin: 'B07W5JKKFJ' },
      { nom: 'Bureau blanc assis-debout', query: 'bureau assis debout blanc' },
    ],
  },
  {
    titre: 'Ambiance Nuit & Néons',
    image: '/images/lookbook/neon.webp',
    description: 'Pour les lives du soir avec une ambiance violette immersive.',
    produits: [
      { nom: 'Barres LED Govee Glide', asin: 'B09H5VSKTZ' },
      { nom: 'Casque Razer Kraken Kitty V2 Quartz', asin: 'B0CCF7M8SG' },
      { nom: 'Elgato Stream Deck Mini blanc', asin: 'B07DYRS1WH' },
    ],
  },
  {
    titre: 'Le Coin Podcast & Chill',
    image: '/images/lookbook/podcast.webp',
    description: 'Confort absolu pour le contenu audio, les lives détente ou l\'ASMR.',
    produits: [
      { nom: 'Micro Shure MV7 blanc', asin: 'B0CTJ6GQGZ' },
      { nom: 'HyperX QuadCast S blanc', asin: 'B0DXW278KB' },
      { nom: 'Chaise gaming rose ergonomique', asin: 'B0CG6TN45R' },
    ],
  },
  {
    titre: 'Gaming Neko',
    image: '/images/lookbook/cat.webp',
    description: 'Le célèbre look "oreilles de chat" qui fait fureur sur Twitch.',
    produits: [
      { nom: 'Razer Kraken Kitty V2 Quartz', asin: 'B0CCF7M8SG' },
      { nom: 'Oreilles de chat universelles', asin: 'B0CCF7ZRLN' },
      { nom: 'Casque HyperX Cloud Stinger 2 blanc', asin: 'B0BCFKG49M' },
    ],
  },
  {
    titre: 'Le Studio Confort',
    image: '/images/lookbook/chair.webp',
    description: 'Une position parfaite pour les longues sessions, sans sacrifier le style.',
    produits: [
      { nom: 'Secretlab Titan Evo édition claire', asin: 'B0FX3MV89W' },
      { nom: 'Chaise Dowinx rose', asin: 'B0CG6TN45R' },
      { nom: 'Logitech Litra Glow', asin: 'B0D2XMLRL3' },
    ],
  },
];
---

<BaseLayout
  title="Lookbook Setup"
  description="Nos inspirations de setups streaming cozy et pastel : clique sur un produit pour recréer l'ambiance chez toi."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="max-w-2xl mb-14">
      <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-4 tracking-tight">Le Lookbook</h1>
      <p class="text-lg text-gray-600">
        Explorez des setups de streaming complets et recréez l'ambiance chez vous pièce par pièce.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {ambiances.map((a) => (
        <div class="bg-white rounded-2xl shadow-sm border border-pink-100 overflow-hidden hover:shadow-md transition-shadow duration-300 flex flex-col">
          <div class="relative w-full aspect-[4/5] bg-gray-100 overflow-hidden group">
            <img src={a.image} alt={a.titre} class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-105" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          </div>
          <div class="p-6 flex flex-col flex-grow">
            <h2 class="text-xl font-extrabold text-gray-900 mb-2">{a.titre}</h2>
            <p class="text-sm text-gray-500 mb-6 flex-grow">{a.description}</p>
            <div class="bg-surface-bg rounded-xl p-4 border border-pink-50">
              <p class="text-xs font-bold uppercase tracking-widest text-pink-600 mb-3 flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
                Shop the look
              </p>
              <ul class="space-y-2">
                {a.produits.map((p) => (
                  <li>
                    <a
                      href={amazonUrl({ asin: p.asin, query: p.nom })}
                      target="_blank"
                      rel="nofollow sponsored noopener"
                      class="group flex items-center justify-between hover:bg-white p-2 -mx-2 rounded-xl transition-all duration-200 border border-transparent hover:border-pink-100 hover:shadow-sm"
                    >
                      <span class="flex items-center gap-3 min-w-0">
                        {p.asin && (
                          <span class="shrink-0 w-14 h-14 bg-white rounded-md border border-gray-100 p-1 flex items-center justify-center overflow-hidden">
                            <img src={`/images/products/${p.asin}.webp`} onerror={`this.onerror=null;this.src='https://m.media-amazon.com/images/P/${p.asin}.01._SCLZZZZZZZ_SX400_.jpg'`} alt={p.nom} referrerpolicy="no-referrer" class="w-full h-full object-contain" loading="lazy" />
                          </span>
                        )}
                        <span class="text-sm font-bold text-gray-700 group-hover:text-pink-600 transition-colors line-clamp-1">{p.nom}</span>
                      </span>
                      <span class="text-pink-400 group-hover:translate-x-1 transition-transform shrink-0 ml-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
