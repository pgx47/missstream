---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site.config';
---

<BaseLayout
  title="Contact"
  description="Une question sur un produit, une suggestion de guide, un partenariat ? Écrivez à l'équipe Miss Stream."
>
  <div class="max-w-2xl mx-auto px-4 py-12">
    <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900">Nous écrire</h1>
    <p class="mt-3 text-gray-500">
      Une question sur un guide, un produit à nous faire tester, une erreur à signaler ?
      On lit tout — réponse sous 48h ouvrées.
    </p>

    <form
      action="https://formsubmit.co/{SITE.email}"
      method="POST"
      class="mt-8 card-aesthetic p-6 space-y-5"
    >
      <input type="hidden" name="_subject" value="Contact missstream.xyz" />
      <input type="hidden" name="_captcha" value="false" />
      <input type="hidden" name="_next" value={`${SITE.url}/contact/?envoye=1`} />

      <div>
        <label for="nom" class="block text-sm font-bold text-gray-700 mb-1.5">Votre nom</label>
        <input
          type="text" id="nom" name="nom" required
          class="w-full rounded-xl border border-pink-100 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-pink-300"
          placeholder="Prénom ou pseudo"
        />
      </div>
      <div>
        <label for="email" class="block text-sm font-bold text-gray-700 mb-1.5">Votre email</label>
        <input
          type="email" id="email" name="email" required
          class="w-full rounded-xl border border-pink-100 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-pink-300"
          placeholder="vous@exemple.fr"
        />
      </div>
      <div>
        <label for="message" class="block text-sm font-bold text-gray-700 mb-1.5">Message</label>
        <textarea
          id="message" name="message" required rows="6"
          class="w-full rounded-xl border border-pink-100 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-pink-300"
          placeholder="Dites-nous tout…"
        ></textarea>
      </div>
      <button type="submit" class="btn-cta w-full px-6 py-3">Envoyer le message</button>
    </form>

    {
      Astro.url.searchParams.get('envoye') && (
        <p class="mt-4 rounded-xl bg-green-50 border border-green-200 text-green-700 text-sm font-bold p-3 text-center">
          Message envoyé, merci ! On revient vers vous vite.
        </p>
      )
    }

    <p class="mt-6 text-sm text-gray-400">
      Vous préférez l'email direct ? <a href={`mailto:${SITE.email}`} class="text-pink-500 font-semibold">{SITE.email}</a>
    </p>
  </div>
</BaseLayout>
