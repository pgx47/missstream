---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { amazonUrl } from '../../site.config';

const palettes = [
  { id: 'pink', label: 'Pink Cozy', bg: '#FDF2F8', fg: '#DB2777' },
  { id: 'lav', label: 'Lavande Lilas', bg: '#FAF5FF', fg: '#9333EA' },
  { id: 'mint', label: 'Menthe Douce', bg: '#F0FDF4', fg: '#16A34A' },
  { id: 'minimal', label: 'Soft Minimal', bg: '#FFFFFF', fg: '#374151' },
];

const panels = ['À Propos', 'Règles', 'Planning', 'Discord', 'Setup', 'Dons', 'Réseaux', 'Commandes'];

const bioProducts = [
  { cat: 'Micro', items: [
    { nom: 'Fifine AM8 blanc', url: amazonUrl({ asin: 'B0C74G9RLH' }) },
    { nom: 'Shure MV7 blanc', url: amazonUrl({ asin: 'B0CTJ6GQGZ' }) },
    { nom: 'Razer Seiren Mini Quartz', url: amazonUrl({ asin: 'B0CT6G556J' }) },
  ]},
  { cat: 'Casque', items: [
    { nom: 'HyperX Cloud Stinger 2 blanc', url: amazonUrl({ asin: 'B0BCFKG49M' }) },
    { nom: 'Razer Kraken Kitty V2 Quartz', url: amazonUrl({ asin: 'B0CCF7M8SG' }) },
  ]},
  { cat: 'Accessoires', items: [
    { nom: 'Elgato Stream Deck Neo', url: amazonUrl({ asin: 'B0CVY4566H' }) },
    { nom: 'Tapis XXL pastel', url: amazonUrl({ asin: 'B0H6M26Z8C' }) },
    { nom: 'Bras Elgato Wave Mic Arm LP', url: amazonUrl({ asin: 'B097376LKF' }) },
  ]},
  { cat: 'Lumière', items: [
    { nom: 'Logitech Litra Glow', url: amazonUrl({ asin: 'B0D2XMLRL3' }) },
    { nom: 'Elgato Key Light Mini', url: amazonUrl({ asin: 'B07L755X9G' }) },
  ]},
];
---

<BaseLayout
  title="Générateur de Panneaux Twitch Gratuits & Aesthetic Pastel | Miss Stream"
  description="Créez vos panneaux Twitch (panels) personnalisés en 1 clic. Style pastel, cozy et minimaliste. Générez aussi votre bio setup avec nos recommandations de matériel."
>
  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <span class="badge-guide mb-2 inline-block">Outil gratuit</span>
      <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900">Générateur de panneaux Twitch</h1>
      <p class="mt-3 text-gray-500">Des panels pastel prêts à l'emploi (320×100 px) + ta bio setup en Markdown. 100% dans ton navigateur.</p>
    </div>

    <div class="grid lg:grid-cols-2 gap-10 items-start">
      <!-- Éditeur -->
      <div class="space-y-8">
        <div class="card-aesthetic p-6">
          <p class="font-extrabold text-gray-900 mb-4">1. Palette</p>
          <div class="grid grid-cols-2 gap-2.5" id="palettes">
            {palettes.map((p, i) => (
              <label class="cursor-pointer">
                <input type="radio" name="palette" value={p.id} checked={i === 0} class="peer sr-only" />
                <span class="block text-center text-xs font-bold px-3 py-2.5 rounded-xl border border-gray-200 peer-checked:border-pink-400 peer-checked:ring-2 peer-checked:ring-pink-200 transition-all" style={`background:${p.bg};color:${p.fg}`}>{p.label}</span>
              </label>
            ))}
          </div>
        </div>

        <div class="card-aesthetic p-6">
          <p class="font-extrabold text-gray-900 mb-4">2. Panneaux</p>
          <div class="grid grid-cols-2 gap-2" id="panels">
            {panels.map((p) => (
              <label class="flex items-center gap-2 text-sm font-semibold text-gray-700">
                <input type="checkbox" class="pnl w-4 h-4 accent-pink-500" value={p} checked={['À Propos','Règles','Planning','Setup','Discord'].includes(p)} /> {p}
              </label>
            ))}
          </div>
          <div class="mt-4 flex gap-2">
            <input id="custom-txt" type="text" placeholder="Nom personnalisé…" class="flex-1 text-sm border border-pink-100 rounded-xl px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-pink-300" />
            <button id="custom-add" class="px-4 py-2.5 rounded-xl bg-pink-500 text-white text-sm font-bold hover:bg-pink-600">+ Ajouter</button>
          </div>
          <label class="mt-4 flex items-center gap-2 text-sm font-semibold text-gray-700">
            <input id="icons" type="checkbox" class="w-4 h-4 accent-pink-500" checked /> Afficher une icône sur les panneaux
          </label>
        </div>

        <div class="card-aesthetic p-6">
          <p class="font-extrabold text-gray-900 mb-4">3. Ta bio setup (copier-coller)</p>
          <div id="bio-list" class="space-y-2 max-h-64 overflow-y-auto">
            {bioProducts.map((g) => (
              <div>
                <p class="text-xs font-extrabold uppercase tracking-widest text-pink-500 mb-1">{g.cat}</p>
                {g.items.map((it) => (
                  <label class="flex items-center gap-2 text-sm text-gray-700 py-0.5">
                    <input type="checkbox" class="bio-it w-4 h-4 accent-pink-500" data-cat={g.cat} data-nom={it.nom} data-url={it.url} /> {it.nom}
                  </label>
                ))}
              </div>
            ))}
          </div>
          <textarea id="bio-out" readonly rows="6" class="mt-4 w-full text-xs font-mono bg-gray-50 border border-pink-100 rounded-xl p-3" placeholder="Coche les produits ci-dessus…"></textarea>
          <button id="bio-copy" class="btn-cta mt-3 px-5 py-2.5 text-sm">Copier le code</button>
        </div>
      </div>

      <!-- Preview -->
      <div class="lg:sticky lg:top-28">
        <div class="card-aesthetic p-6">
          <p class="font-extrabold text-gray-900 mb-4">Aperçu live</p>
          <div id="preview" class="space-y-3"></div>
          <button id="dl" class="btn-cta mt-6 w-full px-6 py-4 text-base font-extrabold">Télécharger mon pack (.zip)</button>
          <p class="mt-3 text-xs text-gray-400 text-center">PNG 320×100 prêts pour les panneaux Twitch.</p>
        </div>
      </div>
    </div>
  </div>

  <script is:inline src="https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js"></script>
  <script is:inline>
    const PAL = {
      pink:   { bg:'#FDF2F8', fg:'#DB2777' },
      lav:    { bg:'#FAF5FF', fg:'#9333EA' },
      mint:   { bg:'#F0FDF4', fg:'#16A34A' },
      minimal:{ bg:'#FFFFFF', fg:'#374151', border:'#F3F4F6' },
    };
    const ICONS = {
      heart: (c,x,y) => { c.beginPath(); c.moveTo(x,y+6); c.bezierCurveTo(x-10,y-4,x-5,y-12,x,y-6); c.bezierCurveTo(x+5,y-12,x+10,y-4,x,y+6); c.fill(); },
      pad:   (c,x,y) => { c.fillRect(x-10,y-4,20,8); c.beginPath(); c.arc(x-8,y-6,5,0,7); c.arc(x+8,y-6,5,0,7); c.fill(); },
      chat:  (c,x,y) => { c.beginPath(); c.ellipse(x,y-2,10,7,0,0,7); c.fill(); c.beginPath(); c.moveTo(x-3,y+3); c.lineTo(x-8,y+9); c.lineTo(x+1,y+4); c.fill(); },
      mic:   (c,x,y) => { c.beginPath(); c.ellipse(x,y-4,4,7,0,0,7); c.fill(); c.fillRect(x-1.5,y+2,3,7); },
    };
    const iconFor = (t) => /règle|commande/.test(t.toLowerCase()) ? 'chat' : /don/.test(t.toLowerCase()) ? 'heart' : /setup|planning/.test(t.toLowerCase()) ? 'pad' : 'mic';

    const $ = (s) => document.querySelector(s);
    const list = () => [...document.querySelectorAll('.pnl:checked')].map(i => i.value);

    function draw(name) {
      const pal = PAL[document.querySelector('input[name=palette]:checked').value];
      const c = document.createElement('canvas');
      const dpr = window.devicePixelRatio || 1;
      c.width = 320 * dpr; c.height = 100 * dpr;
      c.style.width = '100%';
      const ctx = c.getContext('2d');
      ctx.scale(dpr, dpr);
      ctx.fillStyle = pal.bg;
      if (ctx.roundRect) { ctx.beginPath(); ctx.roundRect(0,0,320,100,14); ctx.fill(); } else ctx.fillRect(0,0,320,100);
      if (pal.border) { ctx.strokeStyle = pal.border; ctx.lineWidth = 2; ctx.strokeRect(1,1,318,98); }
      ctx.fillStyle = pal.fg;
      if (document.getElementById('icons').checked) { ICONS[iconFor(name)] ? ICONS[iconFor(name)](ctx, 28, 50) : 0; }
      ctx.font = "800 26px 'Nunito Variable', sans-serif";
      ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.fillText(name, document.getElementById('icons').checked ? 178 : 160, 50);
      return c;
    }

    function render() {
      const prev = document.getElementById('preview');
      prev.innerHTML = '';
      list().forEach(n => {
        const w = document.createElement('div');
        w.appendChild(draw(n));
        prev.appendChild(w);
      });
    }

    document.getElementById('panels').addEventListener('change', render);
    document.getElementById('palettes').addEventListener('change', render);
    document.getElementById('icons').addEventListener('change', render);
    document.getElementById('custom-add').addEventListener('click', () => {
      const t = document.getElementById('custom-txt').value.trim();
      if (!t) return;
      const l = document.createElement('label');
      l.className = 'flex items-center gap-2 text-sm font-semibold text-gray-700';
      l.innerHTML = `<input type="checkbox" class="pnl w-4 h-4 accent-pink-500" value="${t.replace(/"/g,'')}" checked /> ${t}`;
      document.getElementById('panels').appendChild(l);
      document.getElementById('custom-txt').value = '';
      render();
    });

    document.getElementById('dl').addEventListener('click', async () => {
      const zip = new JSZip();
      list().forEach((n,i) => zip.file(`${String(i+1).padStart(2,'0')}-${n.toLowerCase().replace(/[^a-z0-9]+/g,'-')}.png`, draw(n).toDataURL('image/png').split(',')[1], {base64:true}));
      const blob = await zip.generateAsync({type:'blob'});
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob); a.download = 'panneaux-twitch-missstream.zip'; a.click();
    });

    document.querySelectorAll('.bio-it').forEach(b => b.addEventListener('change', () => {
      const lines = {};
      document.querySelectorAll('.bio-it:checked').forEach(x => {
        (lines[x.dataset.cat] ||= []).push(`[${x.dataset.nom}](${x.dataset.url})`);
      });
      document.getElementById('bio-out').value = Object.entries(lines).map(([c,i]) => `- **${c} :** ${i.join(' + ')}`).join('\n') + '\n\n_setup recommandé par missstream.xyz_';
    }));
    document.getElementById('bio-copy').addEventListener('click', (e) => {
      navigator.clipboard.writeText(document.getElementById('bio-out').value);
      e.target.textContent = 'Copié !';
      setTimeout(() => e.target.textContent = 'Copier le code', 1500);
    });

    render();
  </script>
</BaseLayout>
