---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { amazonUrl } from '../../site.config';

const bioProducts = [
  { cat: 'Micro', items: [
    { nom: 'Fifine AM8 blanc', url: amazonUrl({ asin: 'B0C74G9RLH' }) },
    { nom: 'Shure MV7 blanc', url: amazonUrl({ asin: 'B0CTJ6GQGZ' }) },
    { nom: 'Razer Seiren Mini Quartz', url: amazonUrl({ asin: 'B0CT6G556J' }) },
  ]},
  { cat: 'Casque', items: [
    { nom: 'HyperX Cloud Stinger 2 blanc', url: amazonUrl({ asin: 'B0BCFKG49M' }) },
    { nom: 'Razer Kraken Kitty V2 Quartz', url: amazonUrl({ asin: 'B0CCF7M8SG' }) },
  ]},
  { cat: 'Accessoires', items: [
    { nom: 'Elgato Stream Deck Neo', url: amazonUrl({ asin: 'B0CVY4566H' }) },
    { nom: 'Tapis XXL pastel', url: amazonUrl({ asin: 'B0H6M26Z8C' }) },
  ]},
  { cat: 'Lumière', items: [
    { nom: 'Logitech Litra Glow', url: amazonUrl({ asin: 'B0D2XMLRL3' }) },
    { nom: 'Elgato Key Light Mini', url: amazonUrl({ asin: 'B07L755X9G' }) },
  ]},
];
---

<BaseLayout
  title="Générateur de Panneaux Twitch Gratuits & Aesthetic Pastel | Miss Stream"
  description="Créez vos panneaux Twitch (panels) personnalisés en 1 clic. Style pastel, cozy et minimaliste. Générez aussi votre bio setup avec nos recommandations de matériel."
>
  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="text-center max-w-2xl mx-auto mb-8">
      <span class="badge-guide mb-2 inline-block">Outil gratuit</span>
      <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900">Studio de panneaux Twitch</h1>
      <p class="mt-3 text-gray-500">Des panels dignes d'Etsy, générés dans ton navigateur.</p>
    </div>

    <div class="flex justify-center gap-2 p-1.5 bg-pink-50 rounded-2xl w-max mx-auto mb-10">
      <button data-main="panels" class="maintab px-5 py-2.5 rounded-xl text-sm font-extrabold bg-white text-pink-600 shadow-sm">🎨 Créateur de Panneaux</button>
      <button data-main="bio" class="maintab px-5 py-2.5 rounded-xl text-sm font-extrabold text-gray-500 hover:text-pink-500">📝 Bio Setup</button>
    </div>

    <div id="tab-panels">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <div class="lg:col-span-7">
          <div class="bg-purple-50 p-4 rounded-xl mb-6 text-sm text-purple-800 border border-purple-100">
            <p class="font-extrabold mb-1.5">🎨 Crée l'identité de ta chaîne en 3 étapes :</p>
            <p>1. Choisis une ambiance (ou crée tes propres couleurs).</p>
            <p>2. Ajoute, supprime et renomme tes panneaux dans l'onglet <b>Panneaux</b>.</p>
            <p>3. Clique sur <b>Télécharger le pack</b> pour tout récupérer d'un coup.</p>
          </div>
          <div class="flex gap-2 p-1.5 bg-gray-100 rounded-xl mb-6">
            <button data-sub="fond" class="subtab flex-1 px-3 py-2 rounded-lg text-xs font-extrabold bg-white text-pink-600 shadow-sm">🎨 Fond</button>
            <button data-sub="typo" class="subtab flex-1 px-3 py-2 rounded-lg text-xs font-extrabold text-gray-500">✍️ Typo</button>
            <button data-sub="btns" class="subtab flex-1 px-3 py-2 rounded-lg text-xs font-extrabold text-gray-500">🏷️ Panneaux</button>
          </div>

          <div id="sub-fond" class="card-aesthetic p-5 space-y-5">
            <div class="grid grid-cols-2 gap-2.5" id="presets">
              <button data-preset="strawberry" class="preset px-3 py-3 rounded-xl border border-pink-200 text-xs font-extrabold bg-gradient-to-br from-pink-100 to-rose-50 text-pink-700">🍓 Strawberry Milk</button>
              <button data-preset="lavender" class="preset px-3 py-3 rounded-xl border border-purple-200 text-xs font-extrabold bg-gradient-to-br from-purple-100 to-indigo-50 text-purple-700">🌙 Lavender Lofi</button>
              <button data-preset="matcha" class="preset px-3 py-3 rounded-xl border border-green-200 text-xs font-extrabold bg-gradient-to-br from-green-50 to-emerald-50 text-emerald-700">🍵 Matcha Latte</button>
              <button data-preset="studio" class="preset px-3 py-3 rounded-xl border border-gray-200 text-xs font-extrabold bg-white text-gray-700">🤍 Clean Studio</button>
            </div>
            <div class="grid grid-cols-2 gap-3">
              <select id="style" class="text-sm border border-pink-100 rounded-xl px-3 py-2.5">
                <option value="mesh">Mesh gradient (multi-points)</option><option value="flat">Couleur unie</option>
                <option value="glass">Glassmorphism</option><option value="washi">Washi tape</option>
                <option value="image">🖼️ Image perso</option>
              </select>
              <label id="bgimg-wrap" class="hidden col-span-2 px-3 py-2.5 rounded-xl border border-dashed border-pink-300 text-xs font-bold text-pink-500 cursor-pointer text-center">
                Importer mon modèle de bouton
                <input type="file" id="bgimg" accept="image/*" class="sr-only" />
              </label>
              <select id="pattern" class="text-sm border border-pink-100 rounded-xl px-3 py-2.5">
                <option value="none">Sans texture</option><option value="grid">Grid lofi</option><option value="dots">Polka dots</option>
              </select>
              <select id="shape" class="text-sm border border-pink-100 rounded-xl px-3 py-2.5">
                <option value="14">Coins arrondis</option><option value="50">Pilule</option><option value="4">Carrés subtils</option>
              </select>
              <label class="flex items-center gap-2 text-xs font-bold text-gray-500 px-1">
                <input id="sparkles" type="checkbox" class="w-4 h-4 accent-pink-500" checked /> Étincelles
              </label>
            </div>
            <div class="flex flex-wrap gap-4 items-end text-[10px] font-extrabold uppercase text-gray-400">
              <label class="flex flex-col items-center gap-1.5">Couleur 1<input type="color" id="c1" value="#fecdd3" class="swatch" /></label>
              <label class="flex flex-col items-center gap-1.5">Couleur 2<input type="color" id="c2" value="#fbcfe8" class="swatch" /></label>
              <label class="flex flex-col items-center gap-1.5">Texte<input type="color" id="fg" value="#9d174d" class="swatch" /></label>
              <label class="flex flex-col items-center gap-1.5">Bordure<input type="color" id="bord" value="#f9a8d4" class="swatch" /></label>
            </div>
            <div class="grid grid-cols-3 gap-4 text-xs font-bold text-gray-500">
              <label class="flex flex-col gap-1">Hauteur <b id="hv">100</b>px<input type="range" id="hgt" min="70" max="140" value="100" class="accent-pink-500" /></label>
              <label class="flex flex-col gap-1">Bordure <b id="bwv">1.5</b>px <span class="text-[9px] font-normal text-gray-400">2px = effet sticker</span><input type="range" id="bw" min="0" max="4" step="0.5" value="1.5" class="accent-pink-500" /></label>
              <label class="flex flex-col gap-1">Angle <b id="angv">135</b>°<input type="range" id="ang" min="0" max="360" value="135" class="accent-pink-500" /></label>
            </div>
          </div>

          <div id="sub-typo" class="card-aesthetic p-5 space-y-5 hidden">
            <div class="grid grid-cols-2 gap-3">
              <select id="font" class="text-sm border border-pink-100 rounded-xl px-3 py-2.5">
                <option value="Nunito">Nunito (ronde)</option><option value="Fredoka">Fredoka (bulle)</option>
                <option value="Jakarta">Plus Jakarta Sans</option><option value="Playfair">Playfair (chic)</option>
                <option value="Grotesk">Space Grotesk (tech)</option>
              </select>
              <select id="teffect" class="text-sm border border-pink-100 rounded-xl px-3 py-2.5">
                <option value="soft">Ombre douce</option><option value="sticker">Sticker blanc</option>
                <option value="retro">Retro shadow</option><option value="neon">Néon glow</option><option value="none">Net</option>
              </select>
            </div>
            <div class="grid grid-cols-2 gap-4 text-xs font-bold text-gray-500">
              <label class="flex flex-col gap-1">Taille <b id="fzv">24</b>px<input type="range" id="fz" min="16" max="34" value="24" class="accent-pink-500" /></label>
              <label class="flex flex-col gap-1">Espacement <b id="lsv">0</b>px<input type="range" id="ls" min="0" max="6" step="0.5" value="0" class="accent-pink-500" /></label>
            </div>
            <label class="flex items-center gap-2 text-xs font-bold text-gray-500">
              <input id="caps" type="checkbox" class="w-4 h-4 accent-pink-500" /> MAJUSCULES
            </label>
          </div>

          <div id="sub-btns" class="card-aesthetic p-5 space-y-5 hidden">
            <div class="flex gap-2">
              <input id="channel-name" type="text" value="ta_chaine" placeholder="Ton pseudo" class="flex-1 text-sm border border-pink-100 rounded-xl px-3 py-2.5" />
              <label class="px-3 py-2.5 rounded-xl bg-purple-50 text-purple-600 text-xs font-bold cursor-pointer flex items-center gap-1.5">
                <input type="file" id="avatar-file" accept="image/*" class="sr-only" /> Avatar
              </label>
            </div>
            <div id="panel-tags" class="flex flex-wrap gap-2"></div>
            <div class="flex gap-2">
              <input id="custom-txt" type="text" placeholder="Nom personnalisé…" class="flex-1 text-sm border border-pink-100 rounded-xl px-3 py-2.5" />
              <button id="custom-add" class="px-4 py-2.5 rounded-xl bg-pink-500 text-white text-sm font-bold">+ Ajouter</button>
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div class="flex gap-3 text-xs font-bold text-gray-500 items-center">
                <label class="flex items-center gap-1.5"><input type="radio" name="iconpos" value="left" checked class="w-3.5 h-3.5 accent-pink-500" /> Gauche</label>
                <label class="flex items-center gap-1.5"><input type="radio" name="iconpos" value="right" class="w-3.5 h-3.5 accent-pink-500" /> Droite</label>
                <label class="flex items-center gap-1.5"><input type="radio" name="iconpos" value="top" class="w-3.5 h-3.5 accent-pink-500" /> Haut</label>
                <label class="flex items-center gap-1.5"><input type="radio" name="iconpos" value="none" class="w-3.5 h-3.5 accent-pink-500" /> Non</label>
              </div>
              <label class="flex flex-col gap-1 text-xs font-bold text-gray-500">Taille icône <b id="iszv">44</b>px
                <input type="range" id="isz" min="20" max="72" value="44" class="accent-pink-500" /></label>
              <select id="sticker" class="text-sm border border-pink-100 rounded-xl px-3 py-2.5">
                <option value="none">Sans sticker</option><option value="heart">Cœur</option>
                <option value="pad">Manette</option><option value="star">Étoile</option><option value="bow">Nœud</option>
              </select>
            </div>
            <label class="flex flex-col gap-1 text-xs font-bold text-gray-500">
              Logo / émote (PNG) <input type="file" id="logo" accept="image/*" class="text-xs file:mr-3 file:rounded-lg file:border-0 file:bg-pink-50 file:text-pink-600 file:px-3 file:py-1.5 file:font-bold" />
            </label>
          </div>
        </div>

        <div class="lg:col-span-5 lg:sticky lg:top-24">
          <div class="flex items-center gap-2 mb-3">
            <button data-bgmode="dark" class="bgmode px-3 py-1.5 rounded-lg text-[11px] font-extrabold bg-gray-900 text-white">🌙 Sombre</button>
            <button data-bgmode="light" class="bgmode px-3 py-1.5 rounded-lg text-[11px] font-extrabold bg-gray-100 text-gray-600">☀️ Clair</button>
            <label class="flex items-center gap-1.5 text-[11px] font-extrabold text-gray-600 cursor-pointer">
              🎨 <input type="color" id="prev-bg-color" value="#18181b" class="swatch !w-6 !h-6" />
            </label>
          </div>
          <div class="card-aesthetic p-0 overflow-hidden">
            <div id="prev-head" class="bg-[#18181b] px-4 py-3 flex items-center gap-2">
              <div id="prev-avatar" class="w-8 h-8 rounded-full bg-gradient-to-br from-pink-400 to-purple-400 overflow-hidden"></div>
              <div>
                <p id="prev-name" class="text-white text-xs font-bold">ta_chaine</p>
                <p id="prev-live" class="text-purple-300 text-[10px]">EN DIRECT · Aperçu panels</p>
              </div>
            </div>
            <div id="prev-nav" class="bg-[#0e0e10] px-4 py-1 text-[10px] font-bold text-gray-400 flex gap-4 border-b border-white/5">
              <span id="prev-nav-act" class="text-pink-400 border-b-2 border-pink-400 py-2">Accueil</span>
              <span class="py-2">À propos</span><span class="py-2">Calendrier</span><span class="py-2">Vidéos</span>
            </div>
            <div id="preview" class="bg-[#18181b] p-5 grid grid-cols-3 gap-3"></div>
          </div>
          <button id="dl" class="btn-cta mt-5 w-full px-6 py-4 text-base font-extrabold">Télécharger le pack complet (.zip)</button>
          <p class="mt-2 text-[11px] text-gray-400 text-center">💡 Astuce de pro : clique sur un panneau au-dessus pour copier l'image sans la télécharger.</p>
        </div>
      </div>
    </div>

    <details open class="card-aesthetic p-6 mt-12 max-w-3xl mx-auto">
      <summary class="font-extrabold text-gray-900 cursor-pointer list-none flex justify-between">Comment installer tes panneaux sur Twitch ? <span class="text-pink-400">▾</span></summary>
      <ol class="mt-4 space-y-3 text-sm text-gray-600 leading-relaxed list-decimal list-inside">
        <li>Sur ta chaîne, ouvre l'onglet <b>Discussion</b> et active <b>« Éditer les panneaux »</b>.</li>
        <li>Clique sur <b>+</b> → <b>« Ajouter un panneau d'image »</b> et uploade le PNG 320 px généré.</li>
        <li>Colle ton lien (Discord, setup) dans <b>« Lien de l'image »</b>, puis désactive le mode édition.</li>
      </ol>
    </details>

    <div id="tab-bio" class="hidden">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
        <div class="card-aesthetic p-6">
          <p class="font-extrabold text-gray-900 mb-4">Sélection du matériel</p>
          <div class="space-y-2 max-h-72 overflow-y-auto">
            {bioProducts.map((g) => (
              <div>
                <p class="text-xs font-extrabold uppercase tracking-widest text-pink-500 mb-1">{g.cat}</p>
                {g.items.map((it) => (
                  <label class="flex items-center gap-2 text-sm text-gray-700 py-0.5">
                    <input type="checkbox" class="bio-it w-4 h-4 accent-pink-500" data-cat={g.cat} data-nom={it.nom} data-url={it.url} /> {it.nom}
                  </label>
                ))}
              </div>
            ))}
          </div>
          <div class="mt-4 flex gap-2">
            <select id="bio-cat" class="text-xs border border-pink-100 rounded-xl px-2 py-2 w-28">
              <option>Micro</option><option>Casque</option><option>Caméra</option><option>Clavier</option>
              <option>Souris</option><option>Écran</option><option>Éclairage</option><option>Bureau</option><option>Accessoire</option>
            </select>
            <input id="bio-custom" type="text" placeholder="Ton matériel (ex. Sony ZV-E10)" class="flex-1 text-xs border border-pink-100 rounded-xl px-3 py-2" />
            <button id="bio-add" class="px-3 py-2 rounded-xl bg-pink-500 text-white text-xs font-bold">+</button>
          </div>
        </div>
        <div class="card-aesthetic p-6 lg:sticky lg:top-24">
          <p class="font-extrabold text-gray-900 mb-4">Ta bio, prête à coller</p>
          <textarea id="bio-out" readonly rows="12" class="w-full text-xs font-mono bg-gray-50 border border-pink-100 rounded-xl p-3" placeholder="Coche les produits à gauche…"></textarea>
          <button id="bio-copy" class="btn-cta mt-3 w-full px-5 py-3 text-sm font-extrabold">Copier le code</button>
        </div>
      </div>
    </div>
  </div>

  <style>
    .swatch{appearance:none;-webkit-appearance:none;width:2.25rem;height:2.25rem;border-radius:9999px;border:2px solid #fff;box-shadow:0 1px 4px rgba(0,0,0,.15);padding:0;cursor:pointer;background:none}
    .swatch::-webkit-color-swatch-wrapper{padding:0}
    .swatch::-webkit-color-swatch{border:none;border-radius:9999px}
  </style>

  <script is:inline src="https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js"></script>
  <script is:inline>
    const PRESETS = {
      strawberry:{ c1:'#fecdd3', c2:'#fbcfe8', fg:'#9d174d', bord:'#f9a8d4' },
      lavender: { c1:'#ddd6fe', c2:'#c4b5fd', fg:'#6d28d9', bord:'#c4b5fd' },
      matcha:   { c1:'#d9f99d', c2:'#bbf7d0', fg:'#3f6212', bord:'#a3e635' },
      studio:   { c1:'#ffffff', c2:'#fdf2f8', fg:'#374151', bord:'#f9a8d4' },
    };
    const FONTS = { Nunito:"'Nunito Variable', sans-serif", Fredoka:"'Fredoka', sans-serif",
      Jakarta:"'Plus Jakarta Sans', sans-serif", Playfair:"'Playfair Display', serif",
      Grotesk:"'Space Grotesk', sans-serif" };
    const FWT = { Nunito:'800', Fredoka:'600', Jakarta:'700', Playfair:'700', Grotesk:'700' };
    const TAG = 'missstrm-21';
    const PANELS = [{n:'À Propos',s:''},{n:'Règles',s:''},{n:'Planning',s:'Tous les soirs dès 20h'},{n:'Setup',s:''},{n:'Discord',s:'Rejoins le serveur'},{n:'Réseaux',s:''}];
    const STICKERS = {
      heart:(c,x,y,r)=>{c.beginPath();c.moveTo(x,y+r);c.bezierCurveTo(x-r*1.6,y-r*0.4,x-r*0.7,y-r*1.5,x,y-r*0.6);c.bezierCurveTo(x+r*0.7,y-r*1.5,x+r*1.6,y-r*0.4,x,y+r);c.fill();},
      star:(c,x,y,r)=>{c.beginPath();for(let i=0;i<10;i++){const a=i*Math.PI/5-Math.PI/2,l=i%2?r*0.45:r;c.lineTo(x+Math.cos(a)*l,y+Math.sin(a)*l);}c.closePath();c.fill();},
      pad:(c,x,y,r)=>{c.beginPath();if(c.roundRect)c.roundRect(x-r,y-r*0.6,r*2,r*1.2,r*0.4);else c.rect(x-r,y-r*0.6,r*2,r*1.2);c.fill();},
      bow:(c,x,y,r)=>{c.beginPath();c.ellipse(x-r*0.6,y,r*0.55,r*0.35,0.3,0,7);c.fill();c.beginPath();c.ellipse(x+r*0.6,y,r*0.55,r*0.35,-0.3,0,7);c.fill();c.beginPath();c.arc(x,y,r*0.22,0,7);c.fill();}
    };
    let LOGO = null, BGIMG = null;
    const $ = (s) => document.querySelector(s);
    const list = () => PANELS.slice();
    const opt = (id) => document.getElementById(id).value;

    document.querySelectorAll('.maintab').forEach(b=>b.addEventListener('click',()=>{
      document.querySelectorAll('.maintab').forEach(x=>{x.classList.remove('bg-white','text-pink-600','shadow-sm');x.classList.add('text-gray-500');});
      b.classList.add('bg-white','text-pink-600','shadow-sm');b.classList.remove('text-gray-500');
      document.getElementById('tab-panels').classList.toggle('hidden',b.dataset.main!=='panels');
      document.getElementById('tab-bio').classList.toggle('hidden',b.dataset.main!=='bio');
    }));
    document.querySelectorAll('.subtab').forEach(b=>b.addEventListener('click',()=>{
      document.querySelectorAll('.subtab').forEach(x=>{x.classList.remove('bg-white','text-pink-600','shadow-sm');x.classList.add('text-gray-500');});
      b.classList.add('bg-white','text-pink-600','shadow-sm');b.classList.remove('text-gray-500');
      ['fond','typo','btns'].forEach(k=>document.getElementById('sub-'+k).classList.toggle('hidden',b.dataset.sub!==k));
    }));

    function renderTags(){
      const box=document.getElementById('panel-tags');box.innerHTML='';
      PANELS.forEach((pn,i)=>{
        const t=document.createElement('span');
        t.className='inline-flex items-center gap-1 bg-pink-50 border border-pink-100 rounded-lg px-2 py-1';
        const inp=document.createElement('input');
        inp.value=pn.n;inp.className='w-24 bg-transparent text-xs font-bold text-gray-700 outline-none';
        inp.addEventListener('input',()=>{PANELS[i].n=inp.value;render();});
        const si=document.createElement('input');
        si.value=pn.s||'';si.placeholder='sous-titre';si.className='w-24 bg-transparent text-[10px] text-gray-400 outline-none italic';
        si.addEventListener('input',()=>{PANELS[i].s=si.value;render();});
        const x=document.createElement('button');x.textContent='×';
        x.className='text-pink-400 hover:text-pink-600 font-bold text-sm leading-none';
        x.addEventListener('click',()=>{PANELS.splice(i,1);renderTags();render();});
        const col=document.createElement('span');col.className='flex flex-col';
        col.appendChild(inp);col.appendChild(si);
        t.appendChild(col);t.appendChild(x);box.appendChild(t);
      });
    }
    function sparkle(ctx,x,y,r){ctx.beginPath();for(let i=0;i<8;i++){const a=i*Math.PI/4,l=i%2?r*0.35:r;ctx.lineTo(x+Math.cos(a)*l,y+Math.sin(a)*l);}ctx.closePath();ctx.fill();}
    function paintPattern(ctx,type,W,H){
      ctx.save();ctx.globalAlpha=0.12;ctx.strokeStyle='#fff';ctx.fillStyle='#fff';
      if(type==='grid'){ctx.lineWidth=1;for(let x=0;x<=W;x+=16){ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,H);ctx.stroke();}for(let y=0;y<=H;y+=16){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(W,y);ctx.stroke();}}
      if(type==='dots'){for(let x=8;x<W;x+=20){for(let y=8;y<H;y+=20){ctx.beginPath();ctx.arc(x+((y/20)%2)*8,y,1.8,0,7);ctx.fill();}}}
      ctx.restore();
    }

    function draw(panel){
      const name = typeof panel==='object'?panel.n:panel;
      const sub = typeof panel==='object'?(panel.s||''):'';
      const H = +opt('hgt'), dpr = window.devicePixelRatio||1;
      const c1 = opt('c1'), c2 = opt('c2'), fg = opt('fg'), bord = opt('bord'), bw = +opt('bw');
      const c = document.createElement('canvas'); c.width=320*dpr; c.height=H*dpr; c.style.width='100%';
      const ctx = c.getContext('2d'); ctx.scale(dpr,dpr);
      const rad = Math.min(+opt('shape'),H/2), style = opt('style');
      ctx.beginPath();
      if (ctx.roundRect) ctx.roundRect(0,0,320,H,rad); else ctx.rect(0,0,320,H);
      ctx.save();ctx.clip();
      if (style==='image'&&BGIMG){
        const ir=BGIMG.width/BGIMG.height, cr=320/H;
        let dw,dh,dx,dy;
        if(ir>cr){dh=H;dw=H*ir;dx=-(dw-320)/2;dy=0;}else{dw=320;dh=320/ir;dx=0;dy=-(dh-H)/2;}
        ctx.drawImage(BGIMG,dx,dy,dw,dh);
      } else if (style==='mesh'||style==='flat'||style==='image'){
        ctx.fillStyle=c1;ctx.fill();
        if(style==='mesh'){
          const a=+opt('ang')*Math.PI/180,dx=Math.cos(a)*160,dy=Math.sin(a)*160;
          const g=ctx.createLinearGradient(160-dx,H/2-dy,160+dx,H/2+dy);g.addColorStop(0,c1);g.addColorStop(1,c2);
          ctx.fillStyle=g;ctx.fill();}
      } else if (style==='glass'){
        ctx.fillStyle='rgba(255,255,255,0.55)';ctx.fill();
        const g=ctx.createLinearGradient(0,0,320,H);g.addColorStop(0,c1);g.addColorStop(1,c2);
        ctx.globalAlpha=0.35;ctx.fillStyle=g;ctx.fill();ctx.globalAlpha=1;
      } else if (style==='washi'){
        const g=ctx.createLinearGradient(0,0,0,H);g.addColorStop(0,c1);g.addColorStop(1,c2);ctx.fillStyle=g;ctx.fill();
      }
      paintPattern(ctx,opt('pattern'),320,H);
      ctx.restore();
      if(bw>0){ctx.strokeStyle=bord;ctx.lineWidth=bw;if(ctx.roundRect){ctx.beginPath();ctx.roundRect(bw/2,bw/2,320-bw,H-bw,rad);ctx.stroke();}else ctx.strokeRect(0,0,320,H);}
      if(style==='glass'){ctx.strokeStyle='rgba(255,255,255,0.9)';ctx.lineWidth=2;if(ctx.roundRect){ctx.beginPath();ctx.roundRect(2,2,316,H-4,rad);ctx.stroke();}}
      if(style==='washi'){ctx.save();ctx.globalAlpha=0.45;ctx.fillStyle='#fff';ctx.translate(160,4);ctx.rotate(-0.06);ctx.fillRect(-38,0,76,16);ctx.restore();}
      if(document.getElementById('sparkles').checked){ctx.fillStyle='rgba(255,255,255,0.95)';sparkle(ctx,290,20,6);sparkle(ctx,28,H-20,5);}

      const fz = +opt('fz'), ls = +opt('ls'), eff = opt('teffect');
      const txt = document.getElementById('caps').checked ? name.toUpperCase() : name;
      const pos = document.querySelector('input[name=iconpos]:checked').value;
      const isz = +opt('isz');
      let tx = 160, ty = sub?H/2-fz*0.35:H/2+1, ix = null, iy = null;
      if(pos==='left'&&LOGO){ix=14;iy=(H-isz)/2;tx=180+(isz-44)*0.6;}
      if(pos==='right'&&LOGO){ix=306-isz;iy=(H-isz)/2;tx=140-(isz-44)*0.6;}
      if(pos==='top'&&LOGO){ix=160-isz/2;iy=10;ty=H-14-fz/2;}
      ctx.font=`${FWT[opt('font')]} ${fz}px ${FONTS[opt('font')]}`;
      try{ctx.letterSpacing=ls+'px';}catch(e){}
      ctx.textAlign='center';ctx.textBaseline='middle';
      if(eff==='soft'){ctx.shadowColor='rgba(0,0,0,0.12)';ctx.shadowBlur=4;ctx.shadowOffsetY=1;}
      if(eff==='retro'){ctx.shadowColor=fg;ctx.globalAlpha=0.3;ctx.shadowBlur=0;ctx.shadowOffsetX=3;ctx.shadowOffsetY=3;}
      if(eff==='neon'){ctx.shadowColor=fg;ctx.shadowBlur=14;}
      ctx.fillStyle=fg;
      ctx.fillText(txt,tx,ty);
      ctx.shadowColor='transparent';ctx.globalAlpha=1;
      if(eff==='sticker'){ctx.strokeStyle='#fff';ctx.lineWidth=Math.max(4,fz*0.22);ctx.lineJoin='round';ctx.strokeText(txt,tx,ty);ctx.fillStyle=fg;ctx.fillText(txt,tx,ty);}
      if(sub){ctx.font=`600 ${Math.max(11,Math.round(fz*0.5))}px ${FONTS[opt('font')]}`;ctx.globalAlpha=0.75;ctx.fillStyle=fg;ctx.fillText(sub,tx,ty+fz*0.9);ctx.globalAlpha=1;}
      if(LOGO&&pos!=='none'){ctx.drawImage(LOGO,ix,iy,isz,isz);}
      const st=opt('sticker');
      if(st!=='none'&&STICKERS[st]){ctx.fillStyle=fg;ctx.globalAlpha=0.85;STICKERS[st](ctx,302,H-20,9);ctx.globalAlpha=1;}
      return c;
    }

    async function copyCanvas(name,btn){
      const c=draw(name);
      c.toBlob(async(b)=>{try{
        await navigator.clipboard.write([new ClipboardItem({'image/png':b})]);
        btn.textContent='Copié !';setTimeout(()=>btn.textContent='Copier',1200);
      }catch{btn.textContent='…';}});
    }
    function render(){
      const prev=document.getElementById('preview');prev.innerHTML='';
      list().forEach(pn=>{
        const w=document.createElement('div');w.className='relative group';
        const cv=draw(pn);cv.className='rounded-lg w-full cursor-pointer shadow transition-transform duration-150 group-hover:scale-[1.02] group-hover:ring-2 group-hover:ring-pink-400';
        cv.addEventListener('click',()=>copyCanvas(pn,w.querySelector('.cp')));
        const b=document.createElement('button');b.textContent='Copier';
        b.className='cp absolute inset-x-0 bottom-1 mx-auto w-max text-[9px] font-bold bg-white/90 text-gray-700 rounded px-1.5 py-0.5 opacity-0 group-hover:opacity-100 transition-opacity';
        b.addEventListener('click',(e)=>{e.stopPropagation();copyCanvas(pn,b);});
        w.appendChild(cv);w.appendChild(b);prev.appendChild(w);
      });
    }

    document.getElementById('presets').addEventListener('click',(e)=>{
      const b=e.target.closest('.preset');if(!b)return;
      const P=PRESETS[b.dataset.preset];
      document.getElementById('c1').value=P.c1;document.getElementById('c2').value=P.c2;
      document.getElementById('fg').value=P.fg;document.getElementById('bord').value=P.bord;
      render();
    });
    ['hgt','bw','fz','ls','isz','ang'].forEach(id=>{
      document.getElementById(id).addEventListener('input',()=>{
        document.getElementById({hgt:'hv',bw:'bwv',fz:'fzv',ls:'lsv',isz:'iszv',ang:'angv'}[id]).textContent=document.getElementById(id).value;
        render();
      });
    });
    ['style','pattern','shape','font','teffect','sticker'].forEach(id=>document.getElementById(id).addEventListener('change',()=>{
      document.getElementById('bgimg-wrap').classList.toggle('hidden',opt('style')!=='image');
      render();
    }));
    document.getElementById('bgimg').addEventListener('change',(e)=>{
      const f=e.target.files[0];if(!f)return;const i=new Image();
      i.onload=()=>{BGIMG=i;render();};i.src=URL.createObjectURL(f);
    });
    const BGMODES={dark:{bg:'#18181b',nav:'#0e0e10',txt:'#ffffff',live:'#d8b4fe',border:'rgba(255,255,255,0.05)'},
                   light:{bg:'#f7f7f8',nav:'#ffffff',txt:'#1f1f23',live:'#9333ea',border:'rgba(0,0,0,0.08)'}};
    function setPrevBg(mode,color){
      const m=BGMODES[mode]||{bg:color,nav:color,txt:'#1f1f23',live:'#9333ea',border:'rgba(0,0,0,0.08)'};
      document.getElementById('prev-head').style.backgroundColor=m.bg;
      document.getElementById('preview').style.backgroundColor=m.bg;
      document.getElementById('prev-nav').style.backgroundColor=m.nav;
      document.getElementById('prev-nav').style.borderColor=m.border;
      document.getElementById('prev-name').style.color=m.txt;
      document.getElementById('prev-live').style.color=m.live;
      document.getElementById('prev-nav').style.color='#9ca3af';
    }
    document.querySelectorAll('.bgmode').forEach(b=>b.addEventListener('click',()=>setPrevBg(b.dataset.bgmode)));
    document.getElementById('prev-bg-color').addEventListener('input',(e)=>setPrevBg('custom',e.target.value));
    ['c1','c2','fg','bord','sparkles','caps'].forEach(id=>document.getElementById(id).addEventListener('input',render));
    document.querySelectorAll('input[name=iconpos]').forEach(r=>r.addEventListener('change',render));
    document.getElementById('logo').addEventListener('change',(e)=>{
      const f=e.target.files[0];if(!f)return;const i=new Image();
      i.onload=()=>{LOGO=i;render();};i.src=URL.createObjectURL(f);
    });
    document.getElementById('custom-add').addEventListener('click',()=>{
      const t=document.getElementById('custom-txt').value.trim();if(!t)return;
      PANELS.push({n:t,s:''});document.getElementById('custom-txt').value='';renderTags();render();
    });
    document.getElementById('channel-name').addEventListener('input',(e)=>{
      document.getElementById('prev-name').textContent=e.target.value||'ta_chaine';
    });
    document.getElementById('avatar-file').addEventListener('change',(e)=>{
      const f=e.target.files[0];if(!f)return;
      const i=new Image();i.onload=()=>{
        const a=document.getElementById('prev-avatar');a.innerHTML='';
        i.className='w-full h-full object-cover';a.appendChild(i);
      };i.src=URL.createObjectURL(f);
    });
    document.getElementById('bio-add').addEventListener('click',()=>{
      const cat=document.getElementById('bio-cat').value,nom=document.getElementById('bio-custom').value.trim();
      if(!nom)return;
      const url=`https://www.amazon.fr/s?k=${encodeURIComponent(nom)}&tag=${TAG}`;
      const ta=document.getElementById('bio-out');
      ta.value=(ta.value.replace(/\n\n_setup.*$/s,'')+(ta.value.trim() ?'\n':''))+`- **${cat} :** [${nom}](${url})`+'\n\n_setup recommandé par missstream.xyz_';
      document.getElementById('bio-custom').value='';
    });
    function drawBig(W,Hh,text,sub){
      const c=document.createElement('canvas');c.width=W;c.height=Hh;
      const ctx=c.getContext('2d');
      const c1=opt('c1'),c2=opt('c2'),fg=opt('fg'),a=+opt('ang')*Math.PI/180;
      const g=ctx.createLinearGradient(W/2-Math.cos(a)*W/2,Hh/2-Math.sin(a)*Hh/2,W/2+Math.cos(a)*W/2,Hh/2+Math.sin(a)*Hh/2);
      g.addColorStop(0,c1);g.addColorStop(1,c2);ctx.fillStyle=g;ctx.fillRect(0,0,W,Hh);
      paintPattern(ctx,opt('pattern'),W,Hh);
      ctx.fillStyle=fg;ctx.textAlign='center';ctx.textBaseline='middle';
      ctx.font=`${FWT[opt('font')]} ${Math.round(Hh*0.16)}px ${FONTS[opt('font')]}`;
      ctx.shadowColor='rgba(0,0,0,0.15)';ctx.shadowBlur=8;ctx.fillText(text,W/2,Hh/2-(sub?Hh*0.07:0));
      ctx.shadowColor='transparent';
      if(sub){ctx.font=`600 ${Math.round(Hh*0.06)}px ${FONTS[opt('font')]}`;ctx.globalAlpha=0.75;ctx.fillText(sub,W/2,Hh/2+Hh*0.1);ctx.globalAlpha=1;}
      const st=opt('sticker');if(st!=='none'&&STICKERS[st]){ctx.globalAlpha=0.6;ctx.fillStyle=fg;STICKERS[st](ctx,W-70,Hh-60,16);STICKERS[st](ctx,70,60,12);ctx.globalAlpha=1;}
      return c;
    }
    document.getElementById('dl').addEventListener('click',async()=>{
      const zip=new JSZip();
      list().forEach((pn,i)=>zip.file(`${String(i+1).padStart(2,'0')}-${pn.n.toLowerCase().replace(/[^a-z0-9]+/g,'-')}.png`,draw(pn).toDataURL('image/png').split(',')[1],{base64:true}));
      const ch=document.getElementById('channel-name').value||'ta_chaine';
      zip.file('banniere-1200x480.png',drawBig(1200,480,ch,'rejoins le live ♡').toDataURL('image/png').split(',')[1],{base64:true});
      zip.file('ecran-live-bientot-1920x1080.png',drawBig(1920,1080,'LE LIVE COMMENCE BIENTÔT',ch).toDataURL('image/png').split(',')[1],{base64:true});
      const blob=await zip.generateAsync({type:'blob'});
      const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='panneaux-twitch-missstream.zip';a.click();
    });
    document.querySelectorAll('.bio-it').forEach(b=>b.addEventListener('change',()=>{
      const lines={};
      document.querySelectorAll('.bio-it:checked').forEach(x=>{(lines[x.dataset.cat]||=[]).push(`[${x.dataset.nom}](${x.dataset.url})`);});
      document.getElementById('bio-out').value=Object.entries(lines).map(([c,i])=>`- **${c} :** ${i.join(' + ')}`).join('\n')+'\n\n_setup recommandé par missstream.xyz_';
    }));
    document.getElementById('bio-copy').addEventListener('click',(e)=>{
      navigator.clipboard.writeText(document.getElementById('bio-out').value);
      e.target.textContent='Copié !';setTimeout(()=>e.target.textContent='Copier le code',1500);
    });
    ['c1','c2','fg','bord'].forEach(id=>{
      const el=document.getElementById(id);
      const code=document.createElement('span');
      code.className='text-[9px] font-mono text-gray-400';
      code.textContent=el.value;
      el.parentElement.appendChild(code);
      el.addEventListener('input',()=>code.textContent=el.value);
    });
    function saveState(){
      try{
        const st={c1:opt('c1'),c2:opt('c2'),fg:opt('fg'),bord:opt('bord'),hgt:opt('hgt'),bw:opt('bw'),ang:opt('ang'),
          style:opt('style'),pattern:opt('pattern'),shape:opt('shape'),font:opt('font'),teffect:opt('teffect'),
          fz:opt('fz'),ls:opt('ls'),isz:opt('isz'),sticker:opt('sticker'),
          pos:document.querySelector('input[name=iconpos]:checked').value,
          caps:document.getElementById('caps').checked,spark:document.getElementById('sparkles').checked,p:PANELS};
        history.replaceState(null,'','#'+btoa(unescape(encodeURIComponent(JSON.stringify(st)))));
      }catch(e){}
    }
    const _render=render;render=()=>{_render();saveState();};
    try{
      const h=location.hash.slice(1);if(h&&h.length>10){
        const st=JSON.parse(decodeURIComponent(escape(atob(h))));
        ['c1','c2','fg','bord','hgt','bw','ang','style','pattern','shape','font','teffect','fz','ls','isz','sticker'].forEach(k=>{const el=document.getElementById(k);if(el&&st[k]!==undefined)el.value=st[k];});
        if(st.pos){const r=document.querySelector(`input[name=iconpos][value="${st.pos}"]`);if(r)r.checked=true;}
        if(st.caps!==undefined)document.getElementById('caps').checked=st.caps;
        if(st.spark!==undefined)document.getElementById('sparkles').checked=st.spark;
        if(Array.isArray(st.p)){PANELS.length=0;st.p.forEach(x=>PANELS.push(x));}
      }
    }catch(e){}
    renderTags();
    render();
  </script>
</BaseLayout>
