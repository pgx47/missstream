---
import BaseLayout from '../../layouts/BaseLayout.astro';

const sections = [
  {
    titre: 'Graphisme & Twitch',
    outils: [
      { href: '/outils/panneaux-twitch/', image: '/images/outils/panneaux-twitch.webp', titre: 'Générateur de panneaux Twitch', desc: 'Bannières 320×100 pastel, textures, effets texte + bio setup.', badge: 'POPULAIRE' },
      { href: '/lookbook/', image: '/images/outils/lookbook.webp', titre: 'Lookbook d\'inspiration', desc: 'Copie les ambiances de bureau pastel en un clic.', badge: '' },
    ],
  },
  {
    titre: 'Matériel & Budget',
    outils: [
      { href: '/configurateur/', image: '/images/outils/configurateur.webp', titre: 'Configurateur de setup', desc: 'Pack complet adapté à ton budget (150/400/900 €).', badge: 'RECOMMANDÉ' },
      { href: '/dupes/', image: '/images/outils/dupes.webp', titre: 'Dupes & alternatives', desc: 'Les versions abordables du matériel haut de gamme.', badge: '' },
      { href: '/quiz/', image: '/images/outils/quiz.webp', titre: 'Quiz setup idéal', desc: '3 questions pour trouver le matériel qu\'il te faut.', badge: '' },
    ],
  },
  {
    titre: 'Organisation du stream',
    outils: [
      { href: '/checklist/', image: '/images/outils/checklist.webp', titre: 'Checklist avant-live', desc: '8 étapes pour lancer ton stream sans couac.', badge: 'INDISPENSABLE' },
    ],
  },
];
---

<BaseLayout
  title="Tous nos Outils Gratuits pour Créatrices & Streamers | Miss Stream"
  description="Générateur de panneaux Twitch, configurateur de setup, comparateur de dupes, checklist live et lookbook : tous nos outils 100 % gratuits pour votre espace de stream."
>
  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="badge-guide mb-2 inline-block">La boîte à outils</span>
      <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900">Tous nos outils gratuits</h1>
      <p class="mt-3 text-gray-500">Tout pour monter un beau setup et streamer sereinement — sans payer un centime.</p>
    </div>
    {sections.map((sec) => (
      <div class="mb-12">
        <h2 class="text-xs font-extrabold uppercase tracking-widest text-gray-400 mb-4">{sec.titre}</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {sec.outils.map((o) => (
            <a href={o.href} class="group card-aesthetic overflow-hidden flex flex-col justify-between border border-pink-100 hover:border-pink-300 hover:-translate-y-1 hover:shadow-md transition-all duration-300">
              <div>
                <div class="relative w-full aspect-[16/9] overflow-hidden bg-pink-50">
                  <img src={o.image} alt={o.titre} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                  {o.badge && (
                    <span class="absolute top-3 right-3 bg-white/90 backdrop-blur-md text-pink-600 text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded-full shadow-sm">{o.badge}</span>
                  )}
                </div>
                <div class="p-6">
                  <h3 class="text-lg font-extrabold text-gray-900 group-hover:text-pink-500 transition-colors mb-2">{o.titre}</h3>
                  <p class="text-sm text-gray-600 leading-relaxed">{o.desc}</p>
                </div>
              </div>
              <div class="px-6 pb-6 pt-0 flex items-center justify-between text-xs font-extrabold text-pink-600">
                <span>Lancer l'outil</span>
                <span class="group-hover:translate-x-1.5 transition-transform">→</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    ))}
  </div>
</BaseLayout>
