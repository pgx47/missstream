---
import BaseLayout from '../../layouts/BaseLayout.astro';

const sections = [
  {
    titre: 'Graphisme & Twitch',
    outils: [
      { href: '/outils/panneaux-twitch/', titre: 'Générateur de panneaux Twitch', desc: 'Bannières 320×100 pastel + bio setup en 3 clics.', badge: 'POPULAIRE', color: 'pink' },
      { href: '/lookbook/', titre: 'Lookbook d\'inspiration', desc: 'Copie les ambiances de bureau pastel en un clic.', badge: '', color: 'purple' },
    ],
  },
  {
    titre: 'Matériel & Budget',
    outils: [
      { href: '/configurateur/', titre: 'Configurateur de setup', desc: 'Pack complet adapté à ton budget (150/400/900 €).', badge: 'TOP CONVERSION', color: 'pink' },
      { href: '/dupes/', titre: 'Dupes & alternatives', desc: 'Les versions abordables du matériel haut de gamme.', badge: '', color: 'amber' },
      { href: '/quiz/', titre: 'Quiz setup idéal', desc: '3 questions pour trouver le matériel qu\'il te faut.', badge: '', color: 'purple' },
    ],
  },
  {
    titre: 'Organisation du stream',
    outils: [
      { href: '/checklist/', titre: 'Checklist avant-live', desc: '8 étapes pour lancer ton stream sans couac.', badge: 'INDISPENSABLE', color: 'rose' },
    ],
  },
];
const colors: Record<string, string> = {
  pink: 'bg-pink-100 text-pink-600', purple: 'bg-purple-100 text-purple-600',
  amber: 'bg-amber-100 text-amber-600', rose: 'bg-rose-100 text-rose-600',
};
---

<BaseLayout
  title="Tous nos Outils Gratuits pour Créatrices & Streamers | Miss Stream"
  description="Générateur de panneaux Twitch, configurateur de setup, comparateur de dupes, checklist live et lookbook : tous nos outils 100 % gratuits pour votre espace de stream."
>
  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="badge-guide mb-2 inline-block">La boîte à outils</span>
      <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900">Tous nos outils gratuits</h1>
      <p class="mt-3 text-gray-500">Tout pour monter un beau setup et streamer sereinement — sans payer un centime.</p>
    </div>
    {sections.map((sec) => (
      <div class="mb-12">
        <h2 class="text-xs font-extrabold uppercase tracking-widest text-gray-400 mb-4">{sec.titre}</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {sec.outils.map((o) => (
            <a href={o.href} class="card-aesthetic p-6 block group relative">
              {o.badge && <span class="absolute top-4 right-4 bg-pink-500 text-white text-[9px] font-extrabold uppercase px-2 py-0.5 rounded-full">{o.badge}</span>}
              <div class={`w-10 h-10 rounded-xl ${colors[o.color]} flex items-center justify-center mb-4 group-hover:scale-110 transition-transform`}>
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a8 8 0 100 16 8 8 0 000-16z"/></svg>
              </div>
              <h3 class="font-extrabold text-gray-900 group-hover:text-pink-500 transition-colors">{o.titre}</h3>
              <p class="text-sm text-gray-500 mt-1.5">{o.desc}</p>
            </a>
          ))}
        </div>
      </div>
    ))}
  </div>
</BaseLayout>
