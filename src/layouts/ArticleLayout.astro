---
import BaseLayout from './BaseLayout.astro';
import SeoSchema from '../components/SeoSchema.astro';
import AffiliateBox from '../components/AffiliateBox.astro';
import ShopTheLook from '../components/ShopTheLook.astro';
import { SITE, amazonUrl } from '../site.config';

interface FaqItem {
  question: string;
  answer: string;
}

interface Product {
  nom: string;
  asin?: string;
  couleur?: string;
  badge?: string;
  pointsForts: string[];
  pointsFaibles: string[];
  image?: string;
  stars?: number;
  avis?: number;
  avisClient?: string;
}

interface Props {
  title: string;
  description: string;
  image: string;
  publishDate: Date;
  updatedDate?: Date;
  section: string;
  sectionHref: string;
  faq?: FaqItem[];
  products?: Product[];
  shopTheLook?: { nom: string; asin?: string; image?: string }[];
  headings?: { depth: number; slug: string; text: string }[];
  related?: { title: string; href: string; image?: string }[];
}

const {
  title,
  description,
  image,
  publishDate,
  updatedDate,
  section,
  sectionHref,
  faq = [],
  products = [],
  shopTheLook = [],
  headings = [],
  related = [],
} = Astro.props;

const topProduct = products[0];
const topProductUrl = topProduct ? amazonUrl({ asin: topProduct.asin, query: topProduct.nom }) : '';

const toc = headings.filter((h) => h.depth === 2);
const dateFmt = (d: Date) =>
  d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });

const breadcrumbs = [
  { name: 'Accueil', url: '/' },
  { name: section, url: sectionHref },
  { name: title, url: Astro.url.pathname },
];
---

<BaseLayout title={title} description={description} image={image} type="article">
  <SeoSchema
    slot="head"
    type="Article"
    title={title}
    description={description}
    image={image}
    publishDate={publishDate}
    updatedDate={updatedDate}
    url={Astro.url.href}
  />
  <SeoSchema slot="head" type="Breadcrumb" breadcrumbs={breadcrumbs} />
  {faq.length > 0 && <SeoSchema slot="head" type="FAQ" faq={faq} />}
  {
    products.map((p) => (
      <SeoSchema slot="head" type="Product" productName={p.nom} stars={p.stars} avis={p.avis} />
    ))
  }

  <article class="max-w-3xl mx-auto px-4 py-10">
    <nav class="text-xs text-gray-400 mb-6 flex items-center gap-1.5 flex-wrap">
      <a href="/" class="hover:text-pink-600">Accueil</a>
      <span>/</span>
      <a href={sectionHref} class="hover:text-pink-600">{section}</a>
      <span>/</span>
      <span class="text-gray-500 truncate max-w-[220px]">{title}</span>
    </nav>

    <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900 leading-tight">{title}</h1>
    <p class="mt-3 text-sm text-gray-400">
      Publié le {dateFmt(publishDate)}
      {updatedDate && <span> · Mis à jour le {dateFmt(updatedDate)}</span>}
    </p>

    <img
      src={image}
      alt={title}
      width="1200"
      height="630"
      class="mt-6 rounded-2xl w-full object-cover aspect-[2/1] border border-pink-100"
      loading="eager"
    />

    {
      toc.length > 0 && (
        <aside class="mt-8 rounded-2xl bg-white border border-pink-100 p-5">
          <p class="font-bold text-gray-800 text-sm uppercase tracking-wide mb-3">Sommaire</p>
          <ul class="space-y-1.5 text-sm">
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`} class="text-gray-600 hover:text-pink-600 font-medium">
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }

    <div class="prose-cozy mt-8">
      <slot />
    </div>

    {shopTheLook.length > 0 && <ShopTheLook items={shopTheLook} image={image} />}

    <div class="my-8 p-5 rounded-2xl bg-amber-50/60 border border-amber-200 flex items-center justify-between gap-4">
      <div class="flex items-center gap-3.5">
        <svg class="w-7 h-7 text-amber-500 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 001.5-.189m-1.5.189a6.01 6.01 0 01-1.5-.189m3.75 7.478a12.06 12.06 0 01-4.5 0m3.75 2.383a14.406 14.406 0 01-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 10-7.517 0c.85.493 1.509 1.333 1.509 2.316V18"/></svg>
        <div>
          <p class="text-xs uppercase tracking-widest font-extrabold text-amber-700">Budget serré ?</p>
          <p class="text-sm font-bold text-gray-900">Ce modèle dépasse ton budget ?</p>
          <p class="text-xs text-gray-600">Consulte notre sélection d'alternatives accessibles qui font le même travail.</p>
        </div>
      </div>
      <a href="/dupes/" class="shrink-0 px-4 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-600 text-white font-extrabold text-xs shadow-sm transition-colors">Voir les dupes</a>
    </div>

    <div class="my-10 p-6 rounded-2xl bg-gradient-to-r from-pink-50 to-purple-50 border border-pink-100 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="text-left">
        <p class="text-xs uppercase tracking-widest font-bold text-pink-600 mb-1">Tu débutes ?</p>
        <p class="text-base font-extrabold text-gray-900">Découvre les équipements compatibles selon ton budget</p>
        <p class="text-xs text-gray-500 mt-1">Trois packs matériels testés (150 €, 400 € et 900 €) prêts à l'emploi.</p>
      </div>
      <a href="/configurateur/" class="shrink-0 px-5 py-3 rounded-xl bg-white border border-pink-200 text-pink-600 font-extrabold text-sm shadow-sm hover:bg-pink-500 hover:text-white hover:border-pink-500 transition-all">
        Ouvrir le configurateur
      </a>
    </div>

    {
      products.length > 0 && (
        <section class="mt-10">
          <h2 class="text-2xl font-extrabold text-gray-900 mb-5">Récap : les produits de ce guide</h2>
          <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            {products.map((p) => (
              <a
                href={amazonUrl({ asin: p.asin, query: p.nom })}
                target="_blank"
                rel="nofollow sponsored noopener"
                class="card-aesthetic !p-4 flex flex-col items-center text-center group"
              >
                {(p.image || p.asin) && (
                  <img
                    src={p.image || `/images/products/${p.asin}.webp`}
                    onerror={`this.onerror=null;this.src='https://m.media-amazon.com/images/P/${p.asin}.01._SCLZZZZZZZ_SX400_.jpg'`}
                    alt={p.nom}
                    referrerpolicy="no-referrer"
                    class="w-16 h-16 object-contain mb-3"
                    loading="lazy"
                  />
                )}
                {p.badge && <span class="text-[9px] uppercase font-extrabold text-pink-500 bg-pink-50 px-2 py-0.5 rounded-full mb-1">{p.badge}</span>}
                <p class="text-xs font-bold text-gray-800 leading-snug flex-1">{p.nom}</p>
                <span class="mt-2 text-[11px] font-extrabold text-pink-600 group-hover:underline">Voir l'offre ↗</span>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <section class="mt-10 card-aesthetic p-6 border-pink-100">
      <h3 class="font-extrabold text-gray-900 mb-1">Les finitions du setup</h3>
      <p class="text-xs text-gray-500 mb-4">Les petits détails qui changent tout.</p>
      <div class="grid sm:grid-cols-2 gap-2.5">
        {[
          ['Tapis de souris XXL pastel','tapis souris xxl pastel rose','B0H6M26Z8C'],
          ['Bras de micro articulé blanc','bras micro articulé blanc','B0CW3MF8PX'],
          ['Étagère pegboard bureau','etagere pegboard bureau','B08HVZ2LHS'],
          ['Barre lumineuse écran','barre lumineuse ecran moniteur','B08DKQ3JG1'],
        ].map(([nom,q,a]) => (
          <a href={`/go/?a=${a}`} target="_blank" rel="nofollow sponsored noopener" class="flex items-center gap-3 p-3 rounded-xl border border-pink-50 hover:border-pink-200 hover:bg-pink-50/40 transition-colors text-sm font-bold text-gray-700">
            <span class="w-16 h-16 shrink-0 bg-white rounded-lg border border-pink-50 p-1.5 flex items-center justify-center">
              <img src={`/images/products/${a}.webp`} onerror={`this.onerror=null;this.src='https://m.media-amazon.com/images/P/${a}.01._SCLZZZZZZZ_SX400_.jpg'`} alt={nom} loading="lazy" referrerpolicy="no-referrer" class="max-h-full max-w-full object-contain" />
            </span>
            <span class="flex-1">{nom}</span>
            <span class="text-pink-500 text-xs shrink-0">Voir →</span>
          </a>
        ))}
      </div>
    </section>

    {
      faq.length > 0 && (
        <section class="mt-10">
          <h2 class="text-2xl font-extrabold text-gray-900 mb-4">Questions fréquentes</h2>
          <div class="space-y-3">
            {faq.map((item) => (
              <details class="rounded-xl bg-white border border-pink-100 p-4 group">
                <summary class="font-bold text-gray-800 cursor-pointer list-none flex items-center justify-between">
                  {item.question}
                  <span class="text-pink-400 group-open:rotate-45 transition-transform text-xl leading-none">
                    +
                  </span>
                </summary>
                <p class="mt-3 text-sm text-gray-600 leading-relaxed">{item.answer}</p>
              </details>
            ))}
          </div>
        </section>
      )
    }

    {
      related.length > 0 && (
        <section class="mt-10">
          <h2 class="text-2xl font-extrabold text-gray-900 mb-4">À lire aussi</h2>
          <div class="grid sm:grid-cols-3 gap-4">
            {related.map((r) => (
              <a href={r.href} class="card-aesthetic overflow-hidden group flex flex-col">
                {r.image && (
                  <img
                    src={r.image}
                    alt={r.title}
                    width="400"
                    height="300"
                    loading="lazy"
                    class="w-full aspect-[4/3] object-cover"
                  />
                )}
                <p class="p-3 text-sm font-bold text-gray-800 leading-snug group-hover:text-pink-600 transition-colors">
                  {r.title}
                </p>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <p class="mt-10 text-xs text-gray-400 border-t border-gray-100 pt-4 pb-16 md:pb-0">{SITE.affiliationDisclosure}</p>
  </article>

  {
    topProduct && (
      <div class="fixed bottom-0 inset-x-0 z-40 bg-white/95 backdrop-blur-md border-t border-pink-100 p-3 flex items-center justify-between shadow-lg md:hidden">
        <div class="truncate pr-2">
          <p class="text-xs text-gray-500 font-bold uppercase">Recommandé</p>
          <p class="text-sm font-extrabold text-gray-900 truncate">{topProduct.nom}</p>
        </div>
        <a
          href={topProductUrl}
          target="_blank"
          rel="nofollow sponsored noopener"
          class="shrink-0 px-4 py-2 btn-cta text-xs"
        >
          Voir l'offre
        </a>
      </div>
    )
  }
</BaseLayout>
