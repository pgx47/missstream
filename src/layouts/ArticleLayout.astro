---
import BaseLayout from './BaseLayout.astro';
import SeoSchema from '../components/SeoSchema.astro';
import AffiliateBox from '../components/AffiliateBox.astro';
import ShopTheLook from '../components/ShopTheLook.astro';
import { SITE, amazonUrl } from '../site.config';

interface FaqItem {
  question: string;
  answer: string;
}

interface Product {
  nom: string;
  asin?: string;
  couleur?: string;
  badge?: string;
  pointsForts: string[];
  pointsFaibles: string[];
  image?: string;
  stars?: number;
  avis?: number;
  avisClient?: string;
}

interface Props {
  title: string;
  description: string;
  image: string;
  publishDate: Date;
  updatedDate?: Date;
  section: string;
  sectionHref: string;
  faq?: FaqItem[];
  products?: Product[];
  shopTheLook?: { nom: string; asin?: string; image?: string }[];
  headings?: { depth: number; slug: string; text: string }[];
}

const {
  title,
  description,
  image,
  publishDate,
  updatedDate,
  section,
  sectionHref,
  faq = [],
  products = [],
  shopTheLook = [],
  headings = [],
} = Astro.props;

const topProduct = products[0];
const topProductUrl = topProduct ? amazonUrl({ asin: topProduct.asin, query: topProduct.nom }) : '';

const toc = headings.filter((h) => h.depth === 2);
const dateFmt = (d: Date) =>
  d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });

const breadcrumbs = [
  { name: 'Accueil', url: '/' },
  { name: section, url: sectionHref },
  { name: title, url: Astro.url.pathname },
];
---

<BaseLayout title={title} description={description} image={image} type="article">
  <SeoSchema
    slot="head"
    type="Article"
    title={title}
    description={description}
    image={image}
    publishDate={publishDate}
    updatedDate={updatedDate}
    url={Astro.url.href}
  />
  <SeoSchema slot="head" type="Breadcrumb" breadcrumbs={breadcrumbs} />
  {faq.length > 0 && <SeoSchema slot="head" type="FAQ" faq={faq} />}
  {
    products.map((p) => (
      <SeoSchema slot="head" type="Product" productName={p.nom} stars={p.stars} avis={p.avis} />
    ))
  }

  <article class="max-w-3xl mx-auto px-4 py-10">
    <nav class="text-xs text-gray-400 mb-6 flex items-center gap-1.5 flex-wrap">
      <a href="/" class="hover:text-pink-600">Accueil</a>
      <span>/</span>
      <a href={sectionHref} class="hover:text-pink-600">{section}</a>
      <span>/</span>
      <span class="text-gray-500 truncate max-w-[220px]">{title}</span>
    </nav>

    <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900 leading-tight">{title}</h1>
    <p class="mt-3 text-sm text-gray-400">
      Publié le {dateFmt(publishDate)}
      {updatedDate && <span> · Mis à jour le {dateFmt(updatedDate)}</span>}
    </p>

    <img
      src={image}
      alt={title}
      width="1200"
      height="630"
      class="mt-6 rounded-2xl w-full object-cover aspect-[2/1] border border-pink-100"
      loading="eager"
    />

    {
      toc.length > 0 && (
        <aside class="mt-8 rounded-2xl bg-white border border-pink-100 p-5">
          <p class="font-bold text-gray-800 text-sm uppercase tracking-wide mb-3">Sommaire</p>
          <ul class="space-y-1.5 text-sm">
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`} class="text-gray-600 hover:text-pink-600 font-medium">
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }

    <div class="prose-cozy mt-8">
      <slot />
    </div>

    {shopTheLook.length > 0 && <ShopTheLook items={shopTheLook} image={image} />}

    {
      products.length > 0 && (
        <section class="mt-10">
          <h2 class="text-2xl font-extrabold text-gray-900">Les produits de ce guide</h2>
          {products.map((p) => (
            <AffiliateBox
              nom={p.nom}
              asin={p.asin}
              image={p.image}
              stars={p.stars}
              avis={p.avis}
              avisClient={p.avisClient}
              couleur={p.couleur}
              badge={p.badge}
              pointsForts={p.pointsForts}
              pointsFaibles={p.pointsFaibles}
            />
          ))}
        </section>
      )
    }

    {
      faq.length > 0 && (
        <section class="mt-10">
          <h2 class="text-2xl font-extrabold text-gray-900 mb-4">Questions fréquentes</h2>
          <div class="space-y-3">
            {faq.map((item) => (
              <details class="rounded-xl bg-white border border-pink-100 p-4 group">
                <summary class="font-bold text-gray-800 cursor-pointer list-none flex items-center justify-between">
                  {item.question}
                  <span class="text-pink-400 group-open:rotate-45 transition-transform text-xl leading-none">
                    +
                  </span>
                </summary>
                <p class="mt-3 text-sm text-gray-600 leading-relaxed">{item.answer}</p>
              </details>
            ))}
          </div>
        </section>
      )
    }

    <p class="mt-10 text-xs text-gray-400 border-t border-gray-100 pt-4 pb-16 md:pb-0">{SITE.affiliationDisclosure}</p>
  </article>

  {
    topProduct && (
      <div class="fixed bottom-0 inset-x-0 z-40 bg-white/95 backdrop-blur-md border-t border-pink-100 p-3 flex items-center justify-between shadow-lg md:hidden">
        <div class="truncate pr-2">
          <p class="text-xs text-gray-500 font-bold uppercase">Recommandé</p>
          <p class="text-sm font-extrabold text-gray-900 truncate">{topProduct.nom}</p>
        </div>
        <a
          href={topProductUrl}
          target="_blank"
          rel="nofollow sponsored noopener"
          class="shrink-0 px-4 py-2 btn-cta text-xs"
        >
          Voir l'offre
        </a>
      </div>
    )
  }
</BaseLayout>
