---
import { SITE } from '../site.config';
import Logo from '../components/Logo.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article';
}

const {
  title,
  description,
  image = '/images/og-default.webp',
  canonical = Astro.url.pathname,
  type = 'website',
} = Astro.props;

const fullTitle = title === SITE.name ? title : `${title} | ${SITE.name}`;
const canonicalUrl = new URL(canonical, SITE.url).href;
const imageUrl = new URL(image, SITE.url).href;

const nav = [
  { label: 'Articles', href: '/articles/' },
  { label: 'Déco & Setups', href: '/lookbook/' },
  { label: 'Actualités', href: '/actualites/' },
  { label: 'Bons plans', href: '/bons-plans/' },
  { label: 'À propos', href: '/a-propos/' },
];
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>

  <body class="min-h-screen flex flex-col antialiased overflow-x-hidden">
    <div class="bg-gradient-to-r from-pink-500 via-rose-400 to-purple-500 text-white text-xs py-2 px-4 text-center font-bold tracking-wide">
      <span>Micro ou éclairage trop cher ?</span>
      <a href="/dupes/" class="underline underline-offset-2 ml-1.5 hover:text-pink-100">Découvre les alternatives à moitié prix →</a>
    </div>

    <header class="sticky top-0 z-50 bg-white/85 backdrop-blur-lg border-b border-pink-100/60 shadow-sm transition-all duration-300">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 md:h-20 flex items-center justify-between">
        <Logo size="md" />
        <nav class="hidden md:flex items-center gap-8 text-sm font-bold text-gray-600">
          <a href="/articles/" class="relative text-gray-700 hover:text-pink-500 transition-colors duration-300 group py-2">
            Guides Setup
            <span class="absolute inset-x-0 bottom-0 h-0.5 bg-pink-500 scale-x-0 origin-left transition-transform duration-300 group-hover:scale-x-100"></span>
          </a>
          <a href="/lookbook/" class="relative text-gray-700 hover:text-rose-500 transition-colors duration-300 group py-2">
            Déco & Setups
            <span class="absolute inset-x-0 bottom-0 h-0.5 bg-rose-500 scale-x-0 origin-left transition-transform duration-300 group-hover:scale-x-100"></span>
          </a>
          <a href="/streamers/" class="relative text-gray-700 hover:text-purple-500 transition-colors duration-300 group py-2">
            Setups Pros
            <span class="absolute inset-x-0 bottom-0 h-0.5 bg-purple-500 scale-x-0 origin-left transition-transform duration-300 group-hover:scale-x-100"></span>
          </a>
          <a href="/outils/" class="relative text-gray-700 hover:text-pink-500 transition-colors duration-300 group py-2">
            Outils gratuits
            <span class="absolute -top-1 -right-9 bg-pink-500 text-white text-[9px] font-extrabold px-1.5 py-0.5 rounded-full">6 outils</span>
            <span class="absolute inset-x-0 bottom-0 h-0.5 bg-pink-500 scale-x-0 origin-left transition-transform duration-300 group-hover:scale-x-100"></span>
          </a>
          <div class="pl-4 border-l border-gray-200">
            <a href="/bons-plans/" class="btn-cta inline-flex items-center gap-2 px-5 py-2.5 text-sm group">
              <svg class="w-4 h-4 text-pink-100 group-hover:animate-pulse" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M12.395 2.553a1 1 0 00-1.45-.385c-.345.23-.614.558-.822.88-.214.33-.403.713-.57 1.116-.334.804-.614 1.768-.84 2.734a31.365 31.365 0 00-.613 3.58 2.64 2.64 0 01-.945-1.067c-.328-.68-.398-1.534-.398-2.654A1 1 0 005.05 6.05 6.981 6.981 0 003 11a7 7 0 1011.95-4.95c-.592-.591-.98-.985-1.348-1.467-.363-.476-.724-1.063-1.207-2.03zM12.12 15.12A3 3 0 017 13s.879.5 2.5.5c0-1 .5-4 1.25-4.5.5 1 .786 1.293 1.371 1.879A2.99 2.99 0 0113 13a2.99 2.99 0 01-.879 2.121z" clip-rule="evenodd"></path></svg>
              Bons Plans
            </a>
          </div>
        </nav>
        <details class="md:hidden relative">
          <summary
            class="list-none cursor-pointer w-10 h-10 flex items-center justify-center rounded-lg text-gray-600 hover:bg-pink-50"
          >
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          </summary>
          <nav
            class="absolute right-0 mt-2 w-48 bg-white rounded-xl border border-pink-100 shadow-lg p-2 flex flex-col"
          >
            {
              nav.map((item) => (
                <a
                  href={item.href}
                  class="px-3 py-2 rounded-lg text-sm font-semibold text-gray-600 hover:text-pink-600 hover:bg-pink-50"
                >
                  {item.label}
                </a>
              ))
            }
            <a href="/streamers/" class="px-3 py-2 rounded-lg text-sm font-semibold text-gray-600 hover:text-pink-600 hover:bg-pink-50">Setups Pros</a>
            <a href="/outils/" class="px-3 py-2 rounded-lg text-sm font-semibold text-gray-600 hover:text-pink-600 hover:bg-pink-50">Outils gratuits</a>
            <a href="/lookbook/" class="px-3 py-2 rounded-lg text-sm font-semibold text-gray-600 hover:text-pink-600 hover:bg-pink-50">Lookbook</a>
          </nav>
        </details>
      </div>
    </header>

    <main class="flex-1 relative">
      <div class="absolute top-0 inset-x-0 h-64 bg-gradient-to-b from-pink-50/60 to-transparent pointer-events-none -z-10"></div>
      <slot />
    </main>

    <footer class="mt-16 bg-white border-t border-pink-100/80">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">
          <div class="space-y-4">
            <Logo size="sm" />
            <p class="text-sm text-gray-500 leading-relaxed">
              Le guide indépendant pour concevoir un espace de streaming esthétique, cozy
              et performant. Tests matériel, guides débutants et comparatifs design.
            </p>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-pink-50 text-pink-700 border border-pink-100">
              100 % dédié aux créatrices
            </span>
          </div>
          <div>
            <p class="text-xs font-extrabold text-gray-900 uppercase tracking-widest mb-4">Comparatifs</p>
            <ul class="space-y-2.5 text-sm">
              <li><a href="/articles/" class="text-gray-600 hover:text-pink-500 transition-colors">Tous les guides setup</a></li>
              <li>
                <a href="/bons-plans/" class="text-gray-600 hover:text-pink-500 transition-colors flex items-center gap-1.5">
                  Bons plans du jour <span class="text-[10px] bg-rose-100 text-rose-600 font-extrabold px-1.5 py-0.5 rounded">PROMOS</span>
                </a>
              </li>
              <li><a href="/actualites/" class="text-gray-600 hover:text-purple-500 transition-colors">Actualités & sorties tech</a></li>
              <li><a href="/glossaire/" class="text-gray-600 hover:text-pink-500 transition-colors">Glossaire du streaming</a></li>
              <li><a href="/dupes/" class="text-gray-600 hover:text-pink-500 transition-colors">Dupes & alternatives</a></li>
              <li><a href="/streamers/" class="text-gray-600 hover:text-pink-500 transition-colors">Setups des streamers</a></li>
            </ul>
          </div>
          <div>
            <p class="text-xs font-extrabold text-gray-900 uppercase tracking-widest mb-4">Outils gratuits</p>
            <ul class="space-y-2.5 text-sm">
              <li>
                <a href="/configurateur/" class="text-gray-600 hover:text-pink-500 transition-colors flex items-center gap-1.5">
                  Configurateur de budget <span class="text-[10px] bg-pink-100 text-pink-600 font-extrabold px-1.5 py-0.5 rounded">NEW</span>
                </a>
              </li>
              <li><a href="/lookbook/" class="text-gray-600 hover:text-pink-500 transition-colors">Lookbook setups cozy</a></li>
              <li><a href="/checklist/" class="text-gray-600 hover:text-pink-500 transition-colors">Checklist avant-live</a></li>
              <li><a href="/quiz/" class="text-gray-600 hover:text-pink-500 transition-colors">Quiz setup idéal</a></li>
              <li><a href="/outils/panneaux-twitch/" class="text-gray-600 hover:text-pink-500 transition-colors">Générateur de panneaux Twitch</a></li>
            </ul>
          </div>
          <div>
            <p class="text-xs font-extrabold text-gray-900 uppercase tracking-widest mb-4">À propos</p>
            <ul class="space-y-2.5 text-sm">
              <li><a href="/a-propos/" class="text-gray-600 hover:text-pink-500 transition-colors">Ligne éditoriale</a></li>
              <li><a href="/contact/" class="text-gray-600 hover:text-pink-500 transition-colors">Nous contacter</a></li>
              <li><a href="/mentions-legales/" class="text-gray-600 hover:text-pink-500 transition-colors">Mentions légales</a></li>
              <li><a href="/politique-confidentialite/" class="text-gray-600 hover:text-pink-500 transition-colors">Politique de confidentialité</a></li>
            </ul>
          </div>
        </div>
      </div>
      <div class="border-t border-pink-50 bg-[#FAF7F9]/80 py-5">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-3 text-xs text-gray-500 text-center md:text-left">
          <p>© 2026 Miss Stream. Tous droits réservés.</p>
          <p class="max-w-xl text-gray-400">{SITE.affiliationDisclosure}</p>
        </div>
      </div>
    </footer>
  </body>
</html>
