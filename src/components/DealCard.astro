---
import { amazonUrl } from '../site.config';

interface Props {
  asin?: string;
  nom: string;
  categorie?: string;
  badge?: string;
  note?: string;
  image?: string;
  stars?: number;
  avis?: number;
}

const { asin, nom, categorie = 'Setup', badge = 'Promo en cours', note, image, stars, avis } = Astro.props;
const fullStars = stars ? Math.round(stars) : 0;
const url = amazonUrl({ asin, query: nom });
---

{
  /* eslint-disable */
}
<div class="card-aesthetic overflow-hidden flex flex-col">
  {
    asin && (
      <div class="relative w-full aspect-[4/3] bg-pink-50/40 overflow-hidden p-4 flex items-center justify-center">
        <img
          src={image || `https://ws-eu.amazon-adsystem.com/widgets/q?_encoding=UTF8&Format=_SL400_&ASIN=${asin}&MarketPlace=FR&ID=AsinImage`}
          onerror={`this.onerror=null;this.src='https://ws-eu.amazon-adsystem.com/widgets/q?_encoding=UTF8&Format=_SL400_&ASIN=${asin}&MarketPlace=FR&ID=AsinImage'`}
          alt={nom}
          loading="lazy"
          decoding="async"
          referrerpolicy="no-referrer"
          class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-300"
        />
      </div>
    )
  }
  <div class="p-5 flex flex-col flex-1">
  <div class="flex items-start justify-between gap-3 mb-3">
    <span
      class="bg-gradient-to-r from-pink-500 to-purple-400 text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wide"
    >
      {badge}
    </span>
    <span class="text-xs text-gray-400 font-medium">{categorie}</span>
  </div>

  <h3 class="text-lg font-bold text-gray-900 leading-snug flex-1">{nom}</h3>
  {
    stars && (
      <p class="mt-1.5 text-sm">
        <span class="text-amber-400 tracking-tight" aria-hidden="true">
          {'★'.repeat(fullStars)}{'☆'.repeat(5 - fullStars)}
        </span>
        <span class="font-bold text-gray-700 ml-1">{stars.toFixed(1).replace('.', ',')}</span>
        {avis && <span class="text-gray-400"> · {avis.toLocaleString('fr-FR')}</span>}
      </p>
    )
  }
  {note && <p class="text-sm text-gray-500 mt-2">{note}</p>}

  <a
    href={url}
    target="_blank"
    rel="nofollow sponsored noopener"
    class="btn-cta mt-4 block text-center px-4 py-2.5 text-sm"
  >
    Vérifier le prix et la promo ↗
  </a>
  <p class="mt-1.5 text-[11px] text-gray-600 font-semibold text-center">✓ Prime 24h · retours gratuits</p>
  </div>
</div>
