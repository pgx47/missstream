---
import { amazonUrl } from '../site.config';

interface Props {
  asin?: string;
  nom: string;
  categorie?: string;
  badge?: string;
  note?: string;
}

const { asin, nom, categorie = 'Setup', badge = 'Promo en cours', note } = Astro.props;
const url = amazonUrl({ asin, query: nom });
---

<div
  class="rounded-2xl bg-white border border-purple-100 p-5 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all flex flex-col"
>
  <div class="flex items-start justify-between gap-3 mb-3">
    <span
      class="bg-gradient-to-r from-pink-500 to-purple-400 text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wide"
    >
      {badge}
    </span>
    <span class="text-xs text-gray-400 font-medium">{categorie}</span>
  </div>

  <h3 class="text-lg font-bold text-gray-900 leading-snug flex-1">{nom}</h3>
  {note && <p class="text-sm text-gray-500 mt-2">{note}</p>}

  <a
    href={url}
    target="_blank"
    rel="nofollow sponsored noopener"
    class="btn-cta mt-4 block text-center px-4 py-2.5 text-sm"
  >
    Vérifier le prix sur Amazon
  </a>
</div>
