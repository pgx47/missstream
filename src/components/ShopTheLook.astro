---
import { amazonUrl } from '../site.config';

interface Item {
  nom: string;
  asin?: string;
  image?: string;
}

interface Props {
  items: Item[];
  image: string;
}

const { items, image } = Astro.props;
---

<section class="my-10 rounded-2xl overflow-hidden border border-purple-100 bg-white shadow-sm">
  <div class="relative">
    <img src={image} alt="Setup complet de la sélection" class="w-full h-64 object-cover" loading="lazy" />
    <span
      class="absolute top-4 left-4 bg-white/90 backdrop-blur text-purple-700 text-xs font-bold px-3 py-1.5 rounded-full uppercase tracking-widest"
    >
      Shop the look
    </span>
  </div>
  <div class="p-5">
    <p class="font-bold text-gray-800 mb-4">Recrée cette ambiance :</p>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
      {
        items.map((it) => (
          <a
            href={amazonUrl({ asin: it.asin, query: it.nom })}
            target="_blank"
            rel="nofollow sponsored noopener"
            class="group rounded-xl border border-pink-100 p-3 hover:border-pink-300 hover:shadow-md transition-all bg-pink-50/30"
          >
            {it.image && (
              <img
                src={it.image}
                alt={it.nom}
                class="w-full h-20 object-contain bg-white rounded-lg mb-2"
                loading="lazy"
              />
            )}
            <p class="text-xs font-bold text-gray-800 leading-snug group-hover:text-pink-600 transition-colors">
              {it.nom}
            </p>
            <span class="mt-1 inline-block text-[11px] font-bold text-pink-500">Voir le prix →</span>
          </a>
        ))
      }
    </div>
  </div>
</section>
