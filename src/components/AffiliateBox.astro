---
import { amazonUrl } from '../site.config';

interface Props {
  asin?: string;
  nom: string;
  pointsForts: string[];
  pointsFaibles: string[];
  couleur?: string;
  badge?: string;
  tendance?: boolean;
  image?: string;
  stars?: number;
  avis?: number;
  avisClient?: string;
}

const {
  asin,
  nom,
  pointsForts,
  pointsFaibles,
  couleur = 'Rose / Blanc',
  badge = 'Coup de cœur setup',
  tendance = true,
  image,
  stars,
  avis,
  avisClient,
} = Astro.props;

const fullStars = stars ? Math.round(stars) : 0;
const fmtAvis = (n: number) => n.toLocaleString('fr-FR');

const url = amazonUrl({ asin, query: nom });
const urlAvis = asin ? `${url}#customerReviews` : url;
---

<div
  class="my-8 rounded-2xl bg-white border border-pink-100 p-6 shadow-sm hover:shadow-md transition-shadow relative overflow-hidden"
>
  {
    badge && (
      <span class="absolute top-4 right-4 bg-pink-100 text-pink-700 text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider">
        {badge}
      </span>
    )
  }

  <div class="flex gap-4 items-start">
    {
      image && (
        <img
          src={image}
          alt={nom}
          width="112"
          height="112"
          class="w-24 h-24 md:w-28 md:h-28 rounded-xl object-contain bg-white border border-gray-100 shrink-0"
          loading="lazy"
        />
      )
    }
    <div class="min-w-0">
      <h3 class="text-xl font-bold text-gray-900 pr-0 sm:pr-28">{nom}</h3>
      <p class="text-sm text-pink-500 font-medium mt-1">Finition recommandée : {couleur}</p>
      {
        stars && (
          <a
            href={urlAvis}
            target="_blank"
            rel="nofollow sponsored noopener"
            class="mt-1.5 inline-flex items-center gap-1.5 text-sm group"
          >
            <span class="text-amber-400 tracking-tight" aria-hidden="true">
              {'★'.repeat(fullStars)}{'☆'.repeat(5 - fullStars)}
            </span>
            <span class="font-bold text-gray-700">{stars.toFixed(1).replace('.', ',')}</span>
            {avis && (
              <span class="text-gray-400 group-hover:text-pink-500 transition-colors">
                · {fmtAvis(avis)} avis
              </span>
            )}
          </a>
        )
      }
    </div>
  </div>

  <div class="grid md:grid-cols-2 gap-4 my-5 text-sm">
    <div class="bg-rose-50/50 p-4 rounded-xl border border-rose-100">
      <p class="font-bold text-gray-800 mb-2">Pourquoi on l'adore :</p>
      <ul class="space-y-1 text-gray-600">
        {pointsForts.map((pt) => <li>• {pt}</li>)}
      </ul>
    </div>
    <div class="bg-gray-50 p-4 rounded-xl border border-gray-100">
      <p class="font-bold text-gray-700 mb-2">À garder en tête :</p>
      <ul class="space-y-1 text-gray-500">
        {pointsFaibles.map((pt) => <li>• {pt}</li>)}
      </ul>
    </div>
  </div>

  {
    avisClient && (
      <figure class="mt-2 mb-4 rounded-xl bg-pink-50/50 border border-pink-100 p-4">
        <blockquote class="text-sm text-gray-600 italic leading-relaxed">
          « {avisClient} »
        </blockquote>
        <figcaption class="mt-2 text-xs text-gray-400 font-medium">
          Avis client vérifié · Amazon.fr
        </figcaption>
      </figure>
    )
  }

  {
    tendance && (
      <div class="flex items-center gap-2 mb-3 text-sm text-rose-600 bg-rose-50 p-2 rounded-lg border border-rose-100">
        <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 20 20">
          <path d="M10 2a8 8 0 100 16 8 8 0 000-16zm1 11H9v-2h2v2zm0-4H9V5h2v4z" />
        </svg>
        <span>
          <span class="font-bold">Très demandé :</span> les coloris pastel partent souvent vite.
        </span>
      </div>
    )
  }

  <div
    class="mt-6 flex flex-col sm:flex-row items-center justify-between gap-3 pt-4 border-t border-gray-100"
  >
    <a
      href={urlAvis}
      target="_blank"
      rel="nofollow sponsored noopener"
      class="w-full sm:w-auto text-center px-4 py-3 text-sm text-gray-600 bg-gray-50 hover:bg-gray-100 rounded-xl font-bold transition-colors"
    >
      Lire les avis clients
    </a>
    <a
      href={url}
      target="_blank"
      rel="nofollow sponsored noopener"
      class="btn-cta w-full sm:w-auto text-center px-6 py-3"
    >
      Voir le prix sur Amazon
    </a>
  </div>
</div>
