---
import { amazonUrl } from '../site.config';

interface Props {
  asin?: string;
  nom: string;
  pointsForts?: string[];
  pointsFaibles?: string[];
  couleur?: string;
  badge?: string;
  image?: string;
  stars?: number;
  avis?: number;
  avisClient?: string;
}

const {
  asin,
  nom,
  pointsForts = [],
  pointsFaibles = [],
  couleur,
  badge,
  image,
  stars,
  avis,
  avisClient,
} = Astro.props;

const url = amazonUrl({ asin, query: nom });
const imageUrl =
  image ||
  (asin ? `https://ws-eu.amazon-adsystem.com/widgets/q?_encoding=UTF8&Format=_SL400_&ASIN=${asin}&MarketPlace=FR&ID=AsinImage` : '');
const fullStars = stars ? Math.round(stars) : 0;
---

<div class="card-aesthetic p-5 sm:p-6 my-8 flex flex-col md:flex-row gap-6 items-start">
  <!-- Image colonne gauche -->
  <div class="w-full md:w-1/3 shrink-0 bg-[#FAF7F9] rounded-xl p-4 flex items-center justify-center min-h-[220px] relative border border-pink-50">
    {badge && (
      <span class="absolute top-3 right-3 bg-pink-100 text-pink-700 text-[10px] uppercase font-extrabold px-2.5 py-1 rounded-full">{badge}</span>
    )}
    {imageUrl && (
      <img
        src={imageUrl}
        alt={nom}
        loading="lazy"
        decoding="async"
        referrerpolicy="no-referrer"
        onerror={`this.onerror=null;this.src='https://ws-eu.amazon-adsystem.com/widgets/q?_encoding=UTF8&Format=_SL400_&ASIN=${asin}&MarketPlace=FR&ID=AsinImage'`}
        class="max-w-full max-h-52 object-contain drop-shadow-md hover:scale-105 transition-transform duration-300"
      />
    )}
  </div>

  <!-- Contenu droite -->
  <div class="w-full md:w-2/3 flex flex-col">
    <h3 class="text-lg sm:text-xl font-extrabold text-gray-900">{nom}</h3>
    {
      stars && (
        <p class="mt-1 text-sm">
          <span class="text-amber-400 tracking-tight">{'★'.repeat(fullStars)}{'☆'.repeat(5 - fullStars)}</span>
          <span class="font-bold text-gray-700 ml-1">{stars.toFixed(1).replace('.', ',')}</span>
          {avis && <span class="text-gray-400"> · {avis.toLocaleString('fr-FR')} avis</span>}
        </p>
      )
    }
    {couleur && <p class="mt-1 text-xs text-gray-500">Finition : <b class="text-pink-600">{couleur}</b></p>}

    {(pointsForts.length > 0 || pointsFaibles.length > 0) && (
      <div class="grid sm:grid-cols-2 gap-3 my-4 text-sm">
        {pointsForts.length > 0 && (
          <div class="bg-rose-50/50 p-3.5 rounded-xl border border-rose-100">
            <p class="font-bold text-gray-800 mb-1.5">Pourquoi on l'adore :</p>
            <ul class="space-y-1 text-gray-600">{pointsForts.map((pt) => <li>• {pt}</li>)}</ul>
          </div>
        )}
        {pointsFaibles.length > 0 && (
          <div class="bg-gray-50 p-3.5 rounded-xl border border-gray-100">
            <p class="font-bold text-gray-700 mb-1.5">À garder en tête :</p>
            <ul class="space-y-1 text-gray-500">{pointsFaibles.map((pt) => <li>• {pt}</li>)}</ul>
          </div>
        )}
      </div>
    )}

    {avisClient && <p class="text-xs italic text-gray-500 border-l-2 border-pink-200 pl-3 mb-4">« {avisClient} »</p>}

    <div class="mt-auto flex flex-col sm:flex-row gap-3 items-center justify-between">
      <a href={url} target="_blank" rel="nofollow sponsored noopener" class="btn-cta w-full sm:w-auto text-center px-6 py-3">Vérifier le prix et la promo ↗</a>
      <span class="text-[10px] text-gray-400">✓ Prime 24h · retours gratuits</span>
    </div>
  </div>
</div>
