---
interface Props {
  size?: "sm" | "md" | "lg";
}

const { size = "md" } = Astro.props;

const sizes = {
  sm: "h-7",
  md: "h-9",
  lg: "h-12",
};
---

<a href="/" class="group inline-flex items-center transition-transform duration-200 hover:scale-[1.02]">
  <img src="/logo.webp" alt="MissStream" class={`${sizes[size]} w-auto`} />
</a>
